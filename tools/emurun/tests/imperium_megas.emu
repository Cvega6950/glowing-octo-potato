# Crystal Imperium play test: Emerald Imperium's Megas (DECISIONS.md D58).
# 1. The species table in ROM: each new Mega's six base stats, two types and three abilities, the
#    official Emerald Imperium dex's with D58's stand-ins for Imperium's own abilities (Mega
#    Torterra's Thick Fat for Ice Eater, Mega Empoleon O's Adaptability for Emperor's Presence, Mega
#    Coalossal's and Mega Centiskorch's Magic Guard for Mountaineer, Mega Machamp's Iron Fist for
#    ORAORAORAORA!, Mega Garbodor's Regenerator for Parasitic Waste, Mega Dusknoir's Shadow Tag in the
#    hidden slot for THE GRIPPER), and the Mega Evolution flag; a Gigantamax-based Mega weighs what
#    its base form does (the Gigantamax entries, whose sprites it shows, weigh 0).
# 2. Battles against Falkner with the Mega Ring: a level-50 lead holding its stone Mega Evolves by R,
#    then a move. Minimal Grinding (31 IVs, 0 EVs) and a neutral nature make a stat
#    (2 * base + 31) * 50 / 100 + 5, rounded down. Its species, ability and a stat change, and after
#    the battle it is its base form again. Mega Luxray (a newly drawn sprite), Mega Machamp (the
#    Gigantamax sprite, a stand-in ability), Mega Empoleon D (one of a species' two stones), Mega
#    Toxtricity from a Low Key Toxtricity (one stone for two forms), Mega Appletun (Applite, which
#    Flapple shares) and Mega Dusknoir (its hidden ability slot).
# 3. MEGA at the NES gives each of the 23 new stones.
!new_game()
!battle_style_set()
!expect_species_data("SPECIES_BUTTERFREE_MEGA", [60, 45, 100, 80, 140, 100], ["TYPE_BUG", "TYPE_FLYING"], ["ABILITY_COMPOUND_EYES"] * 3, mega=True)
!expect_species_data("SPECIES_MACHAMP_MEGA", [90, 145, 110, 75, 65, 115], ["TYPE_FIGHTING", "TYPE_FIGHTING"], ["ABILITY_IRON_FIST"] * 3, mega=True)
!expect_species_data("SPECIES_KINGLER_MEGA", [55, 150, 130, 110, 50, 75], ["TYPE_WATER", "TYPE_STEEL"], ["ABILITY_TOUGH_CLAWS"] * 3, mega=True)
!expect_species_data("SPECIES_LAPRAS_MEGA", [130, 105, 90, 70, 115, 105], ["TYPE_WATER", "TYPE_DRAGON"], ["ABILITY_LIQUID_VOICE"] * 3, mega=True)
!expect_species_data("SPECIES_SNORLAX_MEGA", [160, 160, 85, 30, 80, 125], ["TYPE_NORMAL", "TYPE_GRASS"], ["ABILITY_THICK_FAT"] * 3, mega=True)
!expect_species_data("SPECIES_SLAKING_MEGA", [150, 160, 110, 110, 95, 75], ["TYPE_NORMAL", "TYPE_NORMAL"], ["ABILITY_COMATOSE"] * 3, mega=True)
!expect_species_data("SPECIES_TORTERRA_MEGA", [115, 139, 135, 56, 75, 105], ["TYPE_GRASS", "TYPE_GROUND"], ["ABILITY_THICK_FAT"] * 3, mega=True)
!expect_species_data("SPECIES_INFERNAPE_MEGA", [76, 137, 82, 120, 137, 82], ["TYPE_FIRE", "TYPE_FIGHTING"], ["ABILITY_IRON_FIST"] * 3, mega=True)
!expect_species_data("SPECIES_EMPOLEON_MEGA_O", [84, 150, 83, 120, 110, 83], ["TYPE_WATER", "TYPE_STEEL"], ["ABILITY_ADAPTABILITY"] * 3, mega=True)
!expect_species_data("SPECIES_EMPOLEON_MEGA_D", [118, 86, 88, 50, 131, 157], ["TYPE_WATER", "TYPE_STEEL"], ["ABILITY_LIGHTNING_ROD"] * 3, mega=True)
!expect_species_data("SPECIES_LUXRAY_MEGA", [95, 130, 79, 130, 110, 79], ["TYPE_ELECTRIC", "TYPE_DARK"], ["ABILITY_STRONG_JAW"] * 3, mega=True)
!expect_species_data("SPECIES_ROSERADE_MEGA", [60, 80, 90, 120, 140, 125], ["TYPE_GRASS", "TYPE_POISON"], ["ABILITY_TECHNICIAN"] * 3, mega=True)
!expect_species_data("SPECIES_DUSKNOIR_MEGA", [105, 110, 150, 45, 65, 150], ["TYPE_GHOST", "TYPE_DARK"], ["ABILITY_PRANKSTER", "ABILITY_PRANKSTER", "ABILITY_SHADOW_TAG"], mega=True)
!expect_species_data("SPECIES_GARBODOR_MEGA", [80, 135, 105, 75, 105, 105], ["TYPE_POISON", "TYPE_POISON"], ["ABILITY_REGENERATOR"] * 3, mega=True)
!expect_species_data("SPECIES_ORBEETLE_MEGA", [60, 45, 125, 100, 135, 130], ["TYPE_BUG", "TYPE_PSYCHIC"], ["ABILITY_MAGIC_GUARD"] * 3, mega=True)
!expect_species_data("SPECIES_DREDNAW_MEGA", [90, 155, 125, 85, 48, 98], ["TYPE_WATER", "TYPE_FIGHTING"], ["ABILITY_STRONG_JAW"] * 3, mega=True)
!expect_species_data("SPECIES_COALOSSAL_MEGA", [110, 80, 125, 45, 125, 105], ["TYPE_STEEL", "TYPE_FIRE"], ["ABILITY_MAGIC_GUARD"] * 3, mega=True)
!expect_species_data("SPECIES_FLAPPLE_MEGA", [70, 145, 90, 105, 135, 70], ["TYPE_GRASS", "TYPE_DRAGON"], ["ABILITY_DRAGONS_MAW"] * 3, mega=True)
!expect_species_data("SPECIES_APPLETUN_MEGA", [110, 105, 100, 40, 135, 100], ["TYPE_GRASS", "TYPE_DRAGON"], ["ABILITY_CONTRARY"] * 3, mega=True)
!expect_species_data("SPECIES_SANDACONDA_MEGA", [72, 140, 160, 81, 85, 90], ["TYPE_GROUND", "TYPE_FLYING"], ["ABILITY_AERILATE"] * 3, mega=True)
!expect_species_data("SPECIES_TOXTRICITY_AMPED_MEGA", [75, 120, 80, 111, 155, 80], ["TYPE_ELECTRIC", "TYPE_POISON"], ["ABILITY_PUNK_ROCK"] * 3, mega=True)
!expect_species_data("SPECIES_TOXTRICITY_LOW_KEY_MEGA", [75, 120, 80, 111, 155, 80], ["TYPE_ELECTRIC", "TYPE_POISON"], ["ABILITY_PUNK_ROCK"] * 3, mega=True)
!expect_species_data("SPECIES_CENTISKORCH_MEGA", [100, 150, 80, 85, 90, 110], ["TYPE_FIRE", "TYPE_BUG"], ["ABILITY_MAGIC_GUARD"] * 3, mega=True)
!expect_species_data("SPECIES_GRIMMSNARL_MEGA", [115, 100, 95, 60, 145, 95], ["TYPE_DARK", "TYPE_FAIRY"], ["ABILITY_SHEER_FORCE"] * 3, mega=True)
!expect_species_data("SPECIES_COPPERAJAH_MEGA", [122, 155, 94, 20, 100, 94], ["TYPE_STEEL", "TYPE_FIGHTING"], ["ABILITY_SHEER_FORCE"] * 3, mega=True)
!expect_species_field("SPECIES_SNORLAX_MEGA", "weight", "4600", "mega_snorlax_weighs_like_snorlax", bits=16)
!give_item("ITEM_MEGA_RING")
savestate megas.ss

# A newly drawn Mega: Luxray holding Luxrite, R, then Crunch. Strong Jaw, Electric/Dark, Speed 90 -> 150
!give_mon_complex("SPECIES_LUXRAY", 50, "NATURE_HARDY", 0, ["MOVE_CRUNCH", "MOVE_SPARK", "MOVE_BITE", "MOVE_LEER"])
!hold_item("ITEM_LUXRITE", 0)
!battle("TRAINER_FALKNER_1_HNS")
!wait_action_menu("luxray_action_menu")
!expect_battler(0, "species", "SPECIES_LUXRAY", "lead_is_luxray")
!expect_battler(0, "item", "ITEM_LUXRITE", "luxray_holds_luxrite")
!expect_battler(0, "speed", "90", "luxray_speed_90")
# Falkner's Pokemon at 1 HP: the battle is won whatever its luck
!weaken_opponents(6)
press A
wait 40
press R
wait 30
shot 01_luxray_mega_trigger.png
press A
!wait_action_menu("luxray_next_turn", 3000)
shot 02_mega_luxray.png
!expect_battler(0, "species", "SPECIES_LUXRAY_MEGA", "luxray_mega_evolved")
!expect_battler(0, "ability", "ABILITY_STRONG_JAW", "mega_luxray_strong_jaw")
!expect_battler(0, "types[0]", "TYPE_ELECTRIC", "mega_luxray_electric", bits=8)
!expect_battler(0, "types[1]", "TYPE_DARK", "mega_luxray_dark", bits=8)
!expect_battler(0, "speed", "150", "mega_luxray_speed_150")
!autobattle("0")
expect8 {gBattleOutcome} 1 falkner_beaten_by_mega_luxray
!expect_party_species("gPlayerParty", 0, "SPECIES_LUXRAY", "luxray_after_battle")

# A Gigantamax-based Mega with a stand-in ability: Machamp holding Machampite, R, then Ice Punch (sure
# to hit: Mega Machamp has Iron Fist, not Machamp's No Guard). Speed 75 -> 95, Attack 150 -> 165
loadstate megas.ss
!give_mon_complex("SPECIES_MACHAMP", 50, "NATURE_HARDY", 0, ["MOVE_ICE_PUNCH", "MOVE_THUNDER_PUNCH", "MOVE_DYNAMIC_PUNCH", "MOVE_BULK_UP"])
!hold_item("ITEM_MACHAMPITE", 0)
!battle("TRAINER_FALKNER_1_HNS")
!wait_action_menu("machamp_action_menu")
!expect_battler(0, "species", "SPECIES_MACHAMP", "lead_is_machamp")
!expect_battler(0, "speed", "75", "machamp_speed_75")
!expect_battler(0, "attack", "150", "machamp_attack_150")
!weaken_opponents(6)
press A
wait 40
press R
wait 30
press A
!wait_action_menu("machamp_next_turn", 3000)
shot 03_mega_machamp.png
!expect_battler(0, "species", "SPECIES_MACHAMP_MEGA", "machamp_mega_evolved")
!expect_battler(0, "ability", "ABILITY_IRON_FIST", "mega_machamp_iron_fist")
!expect_battler(0, "speed", "95", "mega_machamp_speed_95")
!expect_battler(0, "attack", "165", "mega_machamp_attack_165")
!autobattle("0")
expect8 {gBattleOutcome} 1 falkner_beaten_by_mega_machamp
!expect_party_species("gPlayerParty", 0, "SPECIES_MACHAMP", "machamp_after_battle")

# One of a species' two stones: Empoleon holding Empoleonite D becomes Mega Empoleon D, not O.
# Lightning Rod, Speed 80 -> 70, Sp. Atk 131 -> 151
loadstate megas.ss
!give_mon_complex("SPECIES_EMPOLEON", 50, "NATURE_HARDY", 0, ["MOVE_SURF", "MOVE_FLASH_CANNON", "MOVE_ICE_BEAM", "MOVE_GRASS_KNOT"])
!hold_item("ITEM_EMPOLEONITE_D", 0)
!battle("TRAINER_FALKNER_1_HNS")
!wait_action_menu("empoleon_action_menu")
!expect_battler(0, "speed", "80", "empoleon_speed_80")
!expect_battler(0, "spAttack", "131", "empoleon_sp_attack_131")
!weaken_opponents(6)
press A
wait 40
press R
wait 30
press A
!wait_action_menu("empoleon_next_turn", 3000)
shot 04_mega_empoleon_d.png
!expect_battler(0, "species", "SPECIES_EMPOLEON_MEGA_D", "empoleon_mega_d")
!expect_battler(0, "ability", "ABILITY_LIGHTNING_ROD", "mega_empoleon_d_lightning_rod")
!expect_battler(0, "speed", "70", "mega_empoleon_d_speed_70")
!expect_battler(0, "spAttack", "151", "mega_empoleon_d_sp_attack_151")
!autobattle("0")
expect8 {gBattleOutcome} 1 falkner_beaten_by_mega_empoleon_d
!expect_party_species("gPlayerParty", 0, "SPECIES_EMPOLEON", "empoleon_after_battle")

# One stone, two forms: a Low Key Toxtricity (Serious, a Low Key nature, neutral) holding
# Toxtricitite becomes the Low Key Mega Toxtricity. Punk Rock, Speed 95 -> 131. After the battle it
# is a Low Key Toxtricity again, and so is a second one that stayed in the party
loadstate megas.ss
!give_mon_complex("SPECIES_TOXTRICITY_LOW_KEY", 50, "NATURE_SERIOUS", 0, ["MOVE_OVERDRIVE", "MOVE_SLUDGE_BOMB", "MOVE_BOOMBURST", "MOVE_SHIFT_GEAR"])
!give_mon_complex("SPECIES_TOXTRICITY_LOW_KEY", 50, "NATURE_SERIOUS", 0, ["MOVE_OVERDRIVE", "MOVE_SLUDGE_BOMB", "MOVE_BOOMBURST", "MOVE_SHIFT_GEAR"])
!hold_item("ITEM_TOXTRICITITE", 0)
!battle("TRAINER_FALKNER_1_HNS")
!wait_action_menu("toxtricity_action_menu")
!expect_battler(0, "species", "SPECIES_TOXTRICITY_LOW_KEY", "lead_is_low_key")
!expect_battler(0, "speed", "95", "toxtricity_speed_95")
!weaken_opponents(6)
press A
wait 40
press R
wait 30
press A
!wait_action_menu("toxtricity_next_turn", 3000)
shot 05_mega_toxtricity_low_key.png
!expect_battler(0, "species", "SPECIES_TOXTRICITY_LOW_KEY_MEGA", "low_key_mega_toxtricity")
!expect_battler(0, "ability", "ABILITY_PUNK_ROCK", "mega_toxtricity_punk_rock")
!expect_battler(0, "speed", "131", "mega_toxtricity_speed_131")
!autobattle("0")
expect8 {gBattleOutcome} 1 falkner_beaten_by_mega_toxtricity
!expect_party_species("gPlayerParty", 0, "SPECIES_TOXTRICITY_LOW_KEY", "mega_toxtricity_back_to_low_key")
!expect_party_species("gPlayerParty", 1, "SPECIES_TOXTRICITY_LOW_KEY", "second_toxtricity_still_low_key")

# A shared stone: Appletun holding Applite (Flapple's stone too) becomes Mega Appletun. Contrary,
# Sp. Atk 120 -> 155, Speed 50 -> 60
loadstate megas.ss
!give_mon_complex("SPECIES_APPLETUN", 50, "NATURE_HARDY", 0, ["MOVE_DRAGON_PULSE", "MOVE_APPLE_ACID", "MOVE_GIGA_DRAIN", "MOVE_RECOVER"])
!hold_item("ITEM_APPLITE", 0)
!battle("TRAINER_FALKNER_1_HNS")
!wait_action_menu("appletun_action_menu")
!expect_battler(0, "spAttack", "120", "appletun_sp_attack_120")
!weaken_opponents(6)
press A
wait 40
press R
wait 30
press A
!wait_action_menu("appletun_next_turn", 3000)
shot 06_mega_appletun.png
!expect_battler(0, "species", "SPECIES_APPLETUN_MEGA", "appletun_mega_evolved")
!expect_battler(0, "ability", "ABILITY_CONTRARY", "mega_appletun_contrary")
!expect_battler(0, "spAttack", "155", "mega_appletun_sp_attack_155")
!expect_battler(0, "speed", "60", "mega_appletun_speed_60")
!autobattle("0")
expect8 {gBattleOutcome} 1 falkner_beaten_by_mega_appletun
!expect_party_species("gPlayerParty", 0, "SPECIES_APPLETUN", "appletun_after_battle")

# The hidden ability slot: Dusknoir with its hidden Hustle (the next slot after the empty one)
# holding Dusknoirite becomes Mega Dusknoir with that slot's Shadow Tag (for Imperium's THE GRIPPER).
# Attack 120 -> 130; its HP goes up with its base HP (45 -> 105): 120 -> 180. Dark Pulse (Falkner's
# Pidgey is a Normal type)
loadstate megas.ss
!give_mon_complex("SPECIES_DUSKNOIR", 50, "NATURE_HARDY", 1, ["MOVE_DARK_PULSE", "MOVE_ICE_PUNCH", "MOVE_THUNDER_PUNCH", "MOVE_WILL_O_WISP"])
!hold_item("ITEM_DUSKNOIRITE", 0)
!battle("TRAINER_FALKNER_1_HNS")
!wait_action_menu("dusknoir_action_menu")
!expect_battler(0, "ability", "ABILITY_HUSTLE", "dusknoir_hidden_hustle")
!expect_battler(0, "attack", "120", "dusknoir_attack_120")
!expect_battler(0, "maxHP", "120", "dusknoir_max_hp_120")
!weaken_opponents(6)
press A
wait 40
press R
wait 30
press A
!wait_action_menu("dusknoir_next_turn", 3000)
shot 07_mega_dusknoir.png
!expect_battler(0, "species", "SPECIES_DUSKNOIR_MEGA", "dusknoir_mega_evolved")
!expect_battler(0, "ability", "ABILITY_SHADOW_TAG", "mega_dusknoir_shadow_tag")
!expect_battler(0, "attack", "130", "mega_dusknoir_attack_130")
!expect_battler(0, "maxHP", "180", "mega_dusknoir_max_hp_180")
!autobattle("0")
expect8 {gBattleOutcome} 1 falkner_beaten_by_mega_dusknoir
!expect_party_species("gPlayerParty", 0, "SPECIES_DUSKNOIR", "dusknoir_after_battle")

# MEGA at the NES: the 70 stones, among them each of the 23 new ones, in the Bag
loadstate megas.ss
!nes_code("MEGA")
expect16 {gSpecialVar_0x8005} 70 seventy_mega_stones
mash B 600
mash B 600
![check for stone in sum(IMPERIUM_MEGA_STONES, []) for check in expect_bag_quantity("items", stone, 1)]
