# Crystal Imperium play test: the Ace Trainers on Johto's routes (DECISIONS.md D47)
# Each loads with its whole team at the player's level cap, its stage's (D56), against the
# prepared six at that cap, and plays to a result (naive play).
# gEnemyParty: 100 bytes a Pokemon, level at +84; gEnemyPartyCount is the team size.
!new_game()
!battle_style_set()
!no_care_packages()
savestate base.ss

# Stage 0: cap 15
loadstate base.ss
!prepared_team(15, items=True)
savestate stage0.ss
loadstate stage0.ss
!battle("TRAINER_ACE_R29_KAITO_HNS")
waituntil32 {gBattlerControllerFuncs} {HandleInputChooseAction@battle_controller_player} 4000 B ace_r29_kaito_action_menu
expect8 {gEnemyPartyCount} 3 ace_r29_kaito_has_3
expect8 {gEnemyParty+84} 15 ace_r29_kaito_lead_at_15
expect8 {gEnemyParty+284} 15 ace_r29_kaito_last_at_15
!autobattle("0,0,0,0,0,0")
expectne8 {gBattleOutcome} 0 ace_r29_kaito_resolved

loadstate stage0.ss
!battle("TRAINER_ACE_R30_SELENE_HNS")
