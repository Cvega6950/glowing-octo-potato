# Crystal Imperium play test: a TM clerk in every Poke Mart (DECISIONS.md D36), next to the mart's
# clerk at (2,2), talked to across the counter from (4,2), and one at the Indigo Plateau shop. All
# of them, and the Goldenrod Dept. Store 5F, sell the same TMs for the badges the player has
# (data/scripts/tm_shop_hns.inc): 71 with none, 115 with one, 155 with two, ... all 198 with eight.
!new_game()
!max_money()

# Cherrygrove City Mart, no badges
!warp(2, 1, 0)
!walkto(4, 2)
press LEFT
wait 20
press A
wait 120
press A
wait 120
shot 01_cherrygrove_welcome.png
press A
wait 90
shot 02_cherrygrove_list.png
expect16 {sMartInfo+12} 71 cherrygrove_no_badges
mash B 300

# Azalea Town Mart, two badges
!set_flag("FLAG_BADGE01_GET")
!set_flag("FLAG_BADGE02_GET")
!warp(4, 1, 0)
!walkto(4, 2)
press LEFT
wait 20
press A
wait 120
press A
wait 120
press A
wait 90
shot 03_azalea_list.png
expect16 {sMartInfo+12} 155 azalea_two_badges
mash B 300

# Pewter City Mart (Kanto), eight badges: every TM. Buy the first, TM01 Focus Punch
!set_flag("FLAG_BADGE03_GET")
!set_flag("FLAG_BADGE04_GET")
!set_flag("FLAG_BADGE05_GET")
!set_flag("FLAG_BADGE06_GET")
!set_flag("FLAG_BADGE07_GET")
!set_flag("FLAG_BADGE08_GET")
!warp(13, 1, 0)
!walkto(4, 2)
press LEFT
wait 20
press A
wait 120
press A
wait 120
press A
wait 90
shot 04_pewter_list.png
expect16 {sMartInfo+12} 198 pewter_eight_badges
press A
wait 90
press A
wait 60
press A
wait 90
press A
wait 90
shot 05_pewter_bought.png
press A
wait 60
mash B 300
!expect_bag_has("TMsHMs", "ITEM_TM_FOCUS_PUNCH", "bought_focus_punch_in_pewter")

# Indigo Plateau: the TM clerk at (11,10), behind the counter next to the shop's clerk
!warp(21, 0, 0)
!walkto(11, 12, path=True)
press UP
wait 20
press A
wait 120
press A
wait 120
press A
wait 90
shot 06_indigo_list.png
expect16 {sMartInfo+12} 198 indigo_every_tm
mash B 300
