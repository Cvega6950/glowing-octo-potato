# Crystal Imperium play test: Ariana's tag battle in the Rocket Hideout (RocketHideout_B2F_hns), the real one:
# walking down onto her trigger with the Mahogany story at that point (VAR_MAHOGANY_TOWN_STATE 12), she and
# Grunt 23 stop the player, Lance joins as the partner, the player chooses three Pokemon, and the battle is
# multi_2_vs_2 TRAINER_ARIANA_1_HNS with TRAINER_GRUNT_23_HNS and PARTNER_LANCE_HNS. With two opponents each
# brings at most three Pokemon (CreateNPCTrainerPartyFromTrainer): Ariana's first three, at the cap of four
# badges, as her team's data designs them, and the Grunt's first three. Her other three never battle (the
# trainer standard's rules Z2 and DB2: her team for this battle has three). bosses_m4 starts her as a single
# battle and can't see this.
# gEnemyParty: Ariana's at slots 0-2, the Grunt's at 3-5; 100 bytes a Pokemon, level at +84.
!new_game()
!battle_style_set()
!no_care_packages()
!set_flag("FLAG_DISABLE_TRAINERS")
!set_flag("FLAG_DISABLE_ENCOUNTERS")
!set_stage(4)
!give_mon(157, 50)
!give_mon(160, 50)
!give_mon(154, 50)
!set_var("VAR_MAHOGANY_TOWN_STATE", 12)
# B2F, north of her trigger (14-16, 18): one step down onto it
!teleport(*(lambda v: (v["g"], v["n"]))(probe.resolve({"g": "MAP_ROCKET_HIDEOUT_B2F_HNS >> 8", "n": "MAP_ROCKET_HIDEOUT_B2F_HNS & 0xFF"})), 15, 17)
shot 01_before_trigger.png
hold DOWN 16
# Her lines, Lance's, then the half-party menu (A through the texts)
waituntil32 {gMain+4} {CB2_UpdatePartyMenu} 6000 A choose_half_party_menu
wait 60
shot 02_choose_three.png
# ENTER for the first three: the cursor then goes to CONFIRM
press A
wait 30
press A
wait 30
press DOWN
wait 10
press A
wait 30
press A
wait 30
press DOWN
wait 10
press A
wait 30
press A
wait 30
shot 03_three_chosen.png
press A
waituntil32 {gBattlerControllerFuncs} {HandleInputChooseAction@battle_controller_player} 6000 B tag_battle_action_menu
shot 04_battle.png
!expect_battle_type(["BATTLE_TYPE_TRAINER", "BATTLE_TYPE_DOUBLE", "BATTLE_TYPE_TWO_OPPONENTS", "BATTLE_TYPE_MULTI", "BATTLE_TYPE_INGAME_PARTNER"], "a_multi_battle_with_two_opponents_and_lance")
!expect_const("{gTrainerBattleParameter+2}", "TRAINER_ARIANA_1_HNS", "opponent_a_is_ariana")
!expect_opponent_b("TRAINER_GRUNT_23_HNS", "opponent_b_is_grunt_23")
expect8 {gEnemyPartyCount} 6 three_from_each
!expect_designed_party("TRAINER_ARIANA_1_HNS", 4, "ariana", count=3)
!expect_party_species("gEnemyParty", 3, ordinary_species("TRAINER_GRUNT_23_HNS", 0, 4), "grunt_first_at_slot_4")
!expect_party_species("gEnemyParty", 4, ordinary_species("TRAINER_GRUNT_23_HNS", 1, 4), "grunt_second_at_slot_5")
!expect_party_species("gEnemyParty", 5, ordinary_species("TRAINER_GRUNT_23_HNS", 2, 4), "grunt_third_at_slot_6")
expect8 {gEnemyParty+384} 50 grunt_first_at_the_cap
expect8 {gEnemyParty+584} 50 grunt_third_at_the_cap
