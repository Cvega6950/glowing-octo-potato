# Crystal Imperium play test for the second batch of Imperium-style bosses
# (tools/crystal_imperium/boss_teams.py): the Rocket executives in the Rocket Hideout and the
# Radio Tower, the rival in the Goldenrod Underground and on Victory Road, the five Kimono Girls,
# the Elite Four and Lance. The player brings a prepared six at the level cap (good natures and
# moves, no held items; the autopilot uses one move per Pokemon and never switches). Every battle
# plays to a result; each Elite Four member is beaten at least once in three tries, and Lance by a
# six built for him; the bosses' Mega Evolutions happen.
!new_game()
!battle_style_set()
savestate base.ss

# Rocket Hideout (5 or 6 badges)
!prepared_team(36)
savestate prep36.ss
!battle("TRAINER_PETREL_1_HNS")
!autobattle("2,0,1,0,0,0")
expectne8 {gBattleOutcome} 0 petrel_1_resolved
loadstate prep36.ss
!battle("TRAINER_ARIANA_1_HNS")
!autobattle("1,1,1,0,0,0")
expectne8 {gBattleOutcome} 0 ariana_1_resolved

# Radio Tower and the Goldenrod Underground (7 badges, cap 45)
loadstate base.ss
!prepared_team(45)
savestate prep45.ss
!battle("TRAINER_PROTON_2_HNS")
!autobattle("2,0,1,0,0,2")
expectne8 {gBattleOutcome} 0 proton_2_resolved
loadstate prep45.ss
!battle("TRAINER_PETREL_2_HNS")
!autobattle("2,0,1,0,0,0")
expectne8 {gBattleOutcome} 0 petrel_2_resolved
loadstate prep45.ss
!battle("TRAINER_ARIANA_2_HNS")
!autobattle("1,1,1,0,0,0")
expectne8 {gBattleOutcome} 0 ariana_2_resolved
loadstate prep45.ss
seenreset
!battle("TRAINER_ARCHER_HNS")
!autobattle("0,0,0,0,2,2")
expectne8 {gBattleOutcome} 0 archer_resolved
!expect_const_seen("SPECIES_HOUNDOOM_MEGA", "archer_mega_houndoom")
loadstate prep45.ss
!battle("TRAINER_RIVAL_CHIKORITA_4_HNS")
!autobattle("1,0,0,0,0,0")
expectne8 {gBattleOutcome} 0 rival_4_resolved

# Victory Road rival, Kimono Girls, Elite Four and Lance (8 badges, cap 56)
loadstate base.ss
!prepared_team(56)
savestate prep56.ss
seenreset
!battle("TRAINER_RIVAL_CYNDAQUIL_5_HNS")
!autobattle("1,0,0,0,0,0")
expectne8 {gBattleOutcome} 0 rival_5_resolved
!expect_const_seen("SPECIES_TYRANITAR_MEGA", "rival_5_mega_tyranitar")
loadstate prep56.ss
!battle("TRAINER_ZUKI_HNS")
!autobattle("1,0,0,0,0,0")
expectne8 {gBattleOutcome} 0 zuki_resolved
loadstate prep56.ss
!battle("TRAINER_NAOKO_HNS")
!autobattle("0,0,0,0,3,0")
expectne8 {gBattleOutcome} 0 naoko_resolved
loadstate prep56.ss
!battle("TRAINER_MIKI_HNS")
!autobattle("1,0,0,0,0,0")
expectne8 {gBattleOutcome} 0 miki_resolved
loadstate prep56.ss
!battle("TRAINER_SAYO_HNS")
!autobattle("2,2,0,0,0,0")
expectne8 {gBattleOutcome} 0 sayo_resolved
loadstate prep56.ss
!battle("TRAINER_KUNI_HNS")
!autobattle("0,0,0,0,2,0")
expectne8 {gBattleOutcome} 0 kuni_resolved

seenreset
!sample_battle("TRAINER_WILL_1_HNS", "0,0,0,0,3,0", 3, 1, 3, "prep56.ss")
!expect_const_seen("SPECIES_ALAKAZAM_MEGA", "will_mega_alakazam")
seenreset
!sample_battle("TRAINER_KOGA_1_HNS", "2,2,1,0,0,0", 3, 1, 3, "prep56.ss")
!expect_const_seen("SPECIES_BEEDRILL_MEGA", "koga_mega_beedrill")
seenreset
!sample_battle("TRAINER_BRUNO_1_HNS", "1,0,1,0,0,0", 3, 1, 3, "prep56.ss")
!expect_const_seen("SPECIES_LUCARIO_MEGA", "bruno_mega_lucario")
seenreset
!sample_battle("TRAINER_KAREN_1_HNS", "1,0,0,0,0,2", 3, 1, 3, "prep56.ss")
!expect_const_seen("SPECIES_ABSOL_MEGA", "karen_mega_absol")
# Lance: the all-round six above lost all of six tries; a six built for him (Electric, Fairy and
# Ice; no held items) beats him at least once in three
loadstate base.ss
!give_mon_complex("SPECIES_AMPHAROS", 56, "NATURE_MODEST", 0, ["MOVE_THUNDERBOLT", "MOVE_DRAGON_PULSE", "MOVE_FOCUS_BLAST", "MOVE_POWER_GEM"])
!give_mon_complex("SPECIES_GARDEVOIR", 56, "NATURE_MODEST", 0, ["MOVE_MOONBLAST", "MOVE_PSYCHIC", "MOVE_MYSTICAL_FIRE", "MOVE_CALM_MIND"])
!give_mon_complex("SPECIES_MAMOSWINE", 56, "NATURE_ADAMANT", 1, ["MOVE_ICICLE_CRASH", "MOVE_EARTHQUAKE", "MOVE_ICE_SHARD", "MOVE_STEALTH_ROCK"])
!give_mon_complex("SPECIES_TYRANITAR", 56, "NATURE_ADAMANT", 0, ["MOVE_CRUNCH", "MOVE_STONE_EDGE", "MOVE_EARTHQUAKE", "MOVE_DRAGON_DANCE"])
!give_mon_complex("SPECIES_TOGEKISS", 56, "NATURE_MODEST", 1, ["MOVE_MOONBLAST", "MOVE_AIR_SLASH", "MOVE_AURA_SPHERE", "MOVE_NASTY_PLOT"])
!give_mon_complex("SPECIES_GARCHOMP", 56, "NATURE_JOLLY", 1, ["MOVE_EARTHQUAKE", "MOVE_DRAGON_CLAW", "MOVE_FIRE_FANG", "MOVE_SWORDS_DANCE"])
savestate counter56.ss
seenreset
!sample_battle("TRAINER_LANCE_1_HNS", "0,0,0,1,0,1", 3, 1, 3, "counter56.ss")
!expect_const_seen("SPECIES_GYARADOS_MEGA", "lance_mega_gyarados")
