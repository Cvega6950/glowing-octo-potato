# Crystal Imperium play test for the second batch of Imperium-style bosses
# (tools/crystal_imperium/boss_teams.py): the Rocket executives in the Rocket Hideout and the
# Radio Tower, the rival in the Goldenrod Underground and on Victory Road, and the five Kimono
# Girls (the Elite Four and Lance are bosses_e4). The player brings a prepared six at the level cap
# (good natures and moves, holding items from the care packages; the autopilot uses one move per
# Pokemon and never switches). Every battle plays to a result. Archer's and the rival's Mega
# Evolutions happen: those come last, so they are checked with the six at level 100, which always
# gets to them (at the cap the six can lose before the ace comes out).
!new_game()
!battle_style_set()
savestate base.ss

# Rocket Hideout (4 badges at the earliest: cap 50)
!prepared_team(50, items=True)
savestate prep50.ss
!battle("TRAINER_PETREL_1_HNS")
!autobattle("2,0,1,0,0,0")
expectne8 {gBattleOutcome} 0 petrel_1_resolved
loadstate prep50.ss
!battle("TRAINER_ARIANA_1_HNS")
!autobattle("1,1,1,0,0,0")
expectne8 {gBattleOutcome} 0 ariana_1_resolved

# Radio Tower and the Goldenrod Underground (7 badges, cap 75)
loadstate base.ss
!prepared_team(75, items=True)
savestate prep75.ss
!battle("TRAINER_PROTON_2_HNS")
!autobattle("2,0,1,0,0,2")
expectne8 {gBattleOutcome} 0 proton_2_resolved
loadstate prep75.ss
!battle("TRAINER_PETREL_2_HNS")
!autobattle("2,0,1,0,0,0")
expectne8 {gBattleOutcome} 0 petrel_2_resolved
loadstate prep75.ss
!battle("TRAINER_ARIANA_2_HNS")
!autobattle("1,1,1,0,0,0")
expectne8 {gBattleOutcome} 0 ariana_2_resolved
loadstate prep75.ss
!battle("TRAINER_ARCHER_HNS")
!autobattle("0,0,0,0,2,2")
expectne8 {gBattleOutcome} 0 archer_resolved
loadstate prep75.ss
!battle("TRAINER_RIVAL_CHIKORITA_4_HNS")
!autobattle("1,0,0,0,0,0")
expectne8 {gBattleOutcome} 0 rival_4_resolved

# Victory Road rival, Kimono Girls, Elite Four and Lance (8 badges, cap 85)
loadstate base.ss
!prepared_team(85, items=True)
savestate prep85.ss
!battle("TRAINER_RIVAL_CYNDAQUIL_5_HNS")
!autobattle("1,0,0,0,0,0")
expectne8 {gBattleOutcome} 0 rival_5_resolved
loadstate prep85.ss
!battle("TRAINER_ZUKI_HNS")
!autobattle("1,0,0,0,0,0")
expectne8 {gBattleOutcome} 0 zuki_resolved
loadstate prep85.ss
!battle("TRAINER_NAOKO_HNS")
!autobattle("0,0,0,0,3,0")
expectne8 {gBattleOutcome} 0 naoko_resolved
loadstate prep85.ss
!battle("TRAINER_MIKI_HNS")
!autobattle("1,0,0,0,0,0")
expectne8 {gBattleOutcome} 0 miki_resolved
loadstate prep85.ss
!battle("TRAINER_SAYO_HNS")
!autobattle("2,2,0,0,0,0")
expectne8 {gBattleOutcome} 0 sayo_resolved
loadstate prep85.ss
!battle("TRAINER_KUNI_HNS")
!autobattle("0,0,0,0,2,0")
expectne8 {gBattleOutcome} 0 kuni_resolved

# The Megas, with the six at level 100
loadstate base.ss
!prepared_team(100)
savestate prep100.ss
seenreset
!battle("TRAINER_ARCHER_HNS")
!autobattle("0,0,0,0,2,2")
!expect_const_seen("SPECIES_HOUNDOOM_MEGA", "archer_mega_houndoom")
loadstate prep100.ss
seenreset
!battle("TRAINER_RIVAL_CYNDAQUIL_5_HNS")
!autobattle("1,0,0,0,0,0")
!expect_const_seen("SPECIES_TYRANITAR_MEGA", "rival_5_mega_tyranitar")
