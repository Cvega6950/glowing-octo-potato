# Crystal Imperium play test: the Ace Trainers on Kanto's routes (DECISIONS.md D47)
# Each loads with its team, one to three levels below the player's highest (the prepared
# six at the cap of its route's stage), and plays to a result (naive play).
# gEnemyParty: 100 bytes a Pokemon, level at +84; gEnemyPartyCount is the team size.
!new_game()
!battle_style_set()
!no_care_packages()
savestate base.ss

# Stage 9: cap 90
loadstate base.ss
!set_flag("FLAG_BADGE01_GET")
!set_flag("FLAG_BADGE02_GET")
!set_flag("FLAG_BADGE03_GET")
!set_flag("FLAG_BADGE04_GET")
!set_flag("FLAG_BADGE05_GET")
!set_flag("FLAG_BADGE06_GET")
!set_flag("FLAG_BADGE07_GET")
!set_flag("FLAG_BADGE08_GET")
!set_flag("FLAG_IS_CHAMPION")
!prepared_team(90, items=True)
savestate stage9.ss
loadstate stage9.ss
!battle("TRAINER_ACE_R1_MERRICK_HNS")
waituntil32 {gBattlerControllerFuncs} {HandleInputChooseAction@battle_controller_player} 4000 B ace_r1_merrick_action_menu
expect8 {gEnemyPartyCount} 6 ace_r1_merrick_has_6
expect8 {gEnemyParty+84} 87 ace_r1_merrick_lead_at_87
expect8 {gEnemyParty+584} 89 ace_r1_merrick_last_at_89
!autobattle("0,0,0,0,0,0")
expectne8 {gBattleOutcome} 0 ace_r1_merrick_resolved

loadstate stage9.ss
!battle("TRAINER_ACE_R2_SYLVIE_HNS")
