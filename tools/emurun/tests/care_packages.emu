# Crystal Imperium play test: care packages from PROF. ELM (DECISIONS.md D16), Emerald Imperium's
# (that is, Radical Red's): ten of nearly every held item, Berry, booster and evolution item, and big
# stacks (153 Quick Balls, 153 PP Max, 153 Ability Capsules and Patches...). Package 0 arrives on
# the first step out on a route or in a town once the player has a Pokemon, with Imperium's Shiny
# Charm; then one after each milestone: every Gym Badge and becoming Champion (VAR_CARE_PACKAGES
# counts those). The badges and the Champion flag are set with the debug menu here; the delivery is
# the real game code. Contents: tools/crystal_imperium/care_packages.py. The location packages are
# tested by care_packages_start.
!new_game(place_packages=True)
# The debug menu's Give Pokemon sets FLAG_SYS_POKEMON_GET, like receiving the starter
!give_mon(155, 5)
!warp(0, 11, 0)
# The location packages are care_packages_start's: marked as received here, so the steps below only
# bring the starting and milestone packages
!set_var("VAR_CARE_PACKAGE_PLACES", 0x01FF)
savestate route29.ss

# The starting package
!walkto(33, 11, soft=True)
wait 150
shot 01_starting_package.png
press A
wait 200
shot 02_starting_package_contents.png
mash A 2400
!expect_flag("FLAG_RECEIVED_STARTING_CARE_PACKAGE", 1, "starting_package_received")
!expect_var("VAR_CARE_PACKAGES", 0, "no_milestone_package_yet")
!expect_bag_quantity("keyItems", "ITEM_SHINY_CHARM", 1, "imperium_shiny_charm")
!expect_bag_quantity("pokeBalls", "ITEM_QUICK_BALL", 153, "radical_red_quick_balls")
!expect_bag_quantity("items", "ITEM_CHARCOAL", 10, "ten_charcoal")
!expect_bag_quantity("items", "ITEM_METAL_COAT", 10, "ten_metal_coats")
!expect_bag_quantity("items", "ITEM_FAIRY_FEATHER", 10, "ten_fairy_feathers")
!expect_bag_quantity("berries", "ITEM_OCCA_BERRY", 10, "ten_occa_berries")
!expect_bag_quantity("medicine", "ITEM_REVIVE", 10, "ten_revives")
# No milestone, no more (and the player ends on (34, 11), so care_package_steps' first step moves)
!walkto(34, 11)
!expect_var("VAR_CARE_PACKAGES", 0, "no_package_without_milestones")
savestate started.ss

# The eight Johto badges: one package per step until all eight have arrived
!debug_flags_menu(10)
!care_package_steps(8)
shot 03_after_badge_packages.png
!expect_var("VAR_CARE_PACKAGES", 8, "eight_badge_packages")
!expect_var("VAR_CARE_PACKAGE_IMPERIUM", 8, "new_game_contents_keep_up")
# Radical Red's big stacks
!expect_bag_quantity("pokeBalls", "ITEM_HEAL_BALL", 50, "fifty_heal_balls")
!expect_bag_quantity("pokeBalls", "ITEM_DREAM_BALL", 50, "fifty_dream_balls")
!expect_bag_quantity("items", "ITEM_ABILITY_CAPSULE", 153, "ability_capsules")
!expect_bag_quantity("items", "ITEM_ABILITY_PATCH", 153, "ability_patches")
!expect_bag_quantity("medicine", "ITEM_PP_MAX", care_package_total("PP_MAX", range(9)), "pp_max_with_the_153")
# Ten of each held item; Leftovers and Life Orbs come twice, like Radical Red's
!expect_bag_quantity("items", "ITEM_LEFTOVERS", 20)
!expect_bag_quantity("items", "ITEM_LIFE_ORB", 20)
!expect_bag_quantity("items", "ITEM_CHOICE_SCARF", 10)
!expect_bag_quantity("items", "ITEM_KINGS_ROCK", 10)
!expect_bag_quantity("items", "ITEM_RAZOR_CLAW", 10)
!expect_bag_quantity("items", "ITEM_ELECTRIC_SEED", 10)
!expect_bag_quantity("items", "ITEM_PRISM_SCALE", 10)
!expect_bag_quantity("items", "ITEM_UPGRADE", 10)
!expect_bag_quantity("items", "ITEM_LINKING_CORD", 10)
!expect_bag_quantity("items", "ITEM_METAL_ALLOY", 10)
# Since 0.15.0 the evolution items are Emerald Imperium's (D44, D45): none that no evolution uses
# (a Peat Block), nor one only a trade uses (an Electirizer: a Linking Cord evolves Electabuzz too)
!expect_bag_lacks("items", "ITEM_PEAT_BLOCK")
!expect_bag_lacks("items", "ITEM_DUBIOUS_DISC")
!expect_bag_lacks("items", "ITEM_ELECTIRIZER")
!expect_bag_lacks("items", "ITEM_SWEET_APPLE")
!expect_bag_lacks("items", "ITEM_GIMMIGHOUL_COIN")
!expect_bag_quantity("medicine", "ITEM_X_ATTACK", 10)
!expect_bag_quantity("berries", "ITEM_SITRUS_BERRY", care_package_total("SITRUS_BERRY", range(9)))
!expect_bag_quantity("berries", "ITEM_ROSELI_BERRY", care_package_total("ROSELI_BERRY", range(9)))
!expect_bag_quantity("pokeBalls", "ITEM_ULTRA_BALL", care_package_total("ULTRA_BALL", range(9)))
# No milestone, no package
!walkto(33, 11)
!walkto(34, 11)
!expect_var("VAR_CARE_PACKAGES", 8, "no_extra_package")

# Champion: Radical Red's Clair and post-game packages
!debug_flags_menu(11)
!care_package_steps(1)
shot 04_after_champion_package.png
!expect_var("VAR_CARE_PACKAGES", 9, "champion_package")
!expect_bag_quantity("pokeBalls", "ITEM_MASTER_BALL", 1)
!expect_bag_quantity("pokeBalls", "ITEM_BEAST_BALL", 100)
!expect_bag_lacks("keyItems", "ITEM_SCROLL_OF_DARKNESS")
!expect_bag_quantity("items", "ITEM_CHOICE_BAND", 20)
!expect_bag_quantity("berries", "ITEM_GANLON_BERRY", 10)
!expect_var("VAR_CARE_PACKAGE_GEAR", 9, "earlier_catch_up_counter_kept_level")
!expect_var("VAR_CARE_PACKAGE_BULK", 9, "earlier_catch_up_counter_kept_level_too")

# A full Berries pocket: the package's Berries go to the PC, the rest to the Bag
loadstate route29.ss
!fill_pocket("berries", "ITEM_RAZZ_BERRY")
!walkto(33, 11, soft=True)
wait 150
mash A 2400
!expect_flag("FLAG_RECEIVED_STARTING_CARE_PACKAGE", 1, "package_with_full_berry_pocket")
!expect_pc_has("ITEM_OCCA_BERRY", "occa_berries_sent_to_pc")
!expect_pc_has("ITEM_PERSIM_BERRY", "persim_berries_sent_to_pc")
!expect_bag_quantity("items", "ITEM_CHARCOAL", 10, "charcoal_still_in_bag")

# The items pocket keeps 20 slots free for the story's one-time gifts: with only 20 free, the
# package's new kinds of held items go to the PC while it has room
loadstate route29.ss
!fill_pocket("items", "ITEM_HONEY", slots=216)
!walkto(33, 11, soft=True)
wait 150
mash A 2400
!expect_flag("FLAG_RECEIVED_STARTING_CARE_PACKAGE", 1, "package_keeping_the_gift_room")
!expect_pc_has("ITEM_CHARCOAL", "charcoal_to_the_pc")
!expect_pc_has("ITEM_GREEN_SHARD", "shards_to_the_pc")
!expect_pocket_slot_empty("items", 216, "gift_room_kept")
!expect_bag_quantity("pokeBalls", "ITEM_QUICK_BALL", 153, "balls_still_in_the_bag")

# A full items pocket and a full PC: the package stops at its first held item and keeps the rest
# (VAR_CARE_PACKAGE_RESUME: package 0, item 8, the first type booster) until the player is on
# another map
loadstate route29.ss
!fill_pocket("items", "ITEM_HONEY")
!fill_pc("ITEM_HONEY")
!walkto(33, 11, soft=True)
wait 150
mash A 2400
shot 05_bag_and_pc_full.png
!expect_var("VAR_CARE_PACKAGE_RESUME", 0x8008, "stopped_at_the_first_held_item")
!expect_flag("FLAG_RECEIVED_STARTING_CARE_PACKAGE", 0, "starting_package_not_finished")
!expect_bag_quantity("pokeBalls", "ITEM_QUICK_BALL", 153, "balls_arrived_before_it_stopped")
!walkto(34, 11)
!walkto(33, 11)
!expect_var("VAR_CARE_PACKAGE_RESUME", 0x8008, "no_retry_on_the_same_map")
# Room in the Bag, then New Bark Town: the rest arrives, and nothing twice
!empty_pocket("items")
!warp(0, 0, 1)
!walkto(20, 13, soft=True)
wait 150
shot 06_rest_of_the_package.png
mash A 2400
!expect_var("VAR_CARE_PACKAGE_RESUME", 0, "rest_of_the_package_arrived")
!expect_flag("FLAG_RECEIVED_STARTING_CARE_PACKAGE", 1, "starting_package_finished")
!expect_bag_quantity("items", "ITEM_CHARCOAL", 10, "held_items_after_resuming")
!expect_bag_quantity("pokeBalls", "ITEM_QUICK_BALL", 153, "quick_balls_not_given_twice")
!expect_bag_quantity("keyItems", "ITEM_SHINY_CHARM", 1, "shiny_charm_not_given_twice")

# A save from before 0.12.0 with three badges: its three packages, and the starting one it never
# had, arrive again with the new contents, on top of what the save got then; then the next badge's
# package as usual
loadstate route29.ss
!set_flag("FLAG_BADGE01_GET")
!set_flag("FLAG_BADGE02_GET")
!set_flag("FLAG_BADGE03_GET")
!set_var("VAR_CARE_PACKAGES", 3)
!set_var("VAR_CARE_PACKAGE_GEAR", 3)
!set_var("VAR_CARE_PACKAGE_BULK", 3)
!care_package_steps(1)
!expect_flag("FLAG_RECEIVED_STARTING_CARE_PACKAGE", 1, "old_save_starting_package")
!walkto(34, 11, soft=True)
wait 150
shot 07_bigger_version.png
mash A 2400
!expect_var("VAR_CARE_PACKAGE_IMPERIUM", 1, "old_save_first_update")
!expect_var("VAR_CARE_PACKAGES", 3, "old_save_no_new_package_yet")
!expect_bag_quantity("pokeBalls", "ITEM_HEAL_BALL", 50, "old_save_heal_balls")
!care_package_steps(2)
!expect_var("VAR_CARE_PACKAGE_IMPERIUM", 3, "old_save_all_three_updated")
!expect_bag_quantity("items", "ITEM_ABILITY_CAPSULE", 153, "old_save_ability_capsules")
!expect_bag_quantity("pokeBalls", "ITEM_DREAM_BALL", 50, "old_save_dream_balls")
!walkto(33, 11)
!walkto(34, 11)
!expect_var("VAR_CARE_PACKAGES", 3, "old_save_nothing_more")
!set_flag("FLAG_BADGE04_GET")
!care_package_steps(1)
!expect_var("VAR_CARE_PACKAGES", 4, "old_save_fourth_badge_package")
!expect_var("VAR_CARE_PACKAGE_IMPERIUM", 4, "old_save_fourth_badge_package_counted")
!expect_bag_quantity("items", "ITEM_SMOKE_BALL", 10, "old_save_fourth_package_contents")
