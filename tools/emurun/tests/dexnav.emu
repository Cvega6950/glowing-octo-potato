# Crystal Imperium play test: the DexNav, in the start menu from a new game.
# Route 29 at night lists Hoothoot and Rattata (second land icon). DexNav shows every Pokemon
# in the area, seen or not: nothing has been seen yet, and Rattata is registered with R anyway.
# Close DexNav, press R in the grass to search, walk normally (no sneaking with A) to the
# rustling tile, and the DexNav battle starts.
# Catching the DexNav Rattata raises its search level and the DexNav chain. The Infinite Repel
# keeps random encounters away; it does not stop DexNav encounters.
# The search target is sDexNavSearchDataPtr: species +0, tileX +18, tileY +20 (map coords + 7).
!new_game()
!give_mon(155, 5)
!give_item(1, 10)
!warp(0, 11, 0)
# Infinite Repel on (Key Item 1), so no random wild battle interrupts; DexNav battles still happen
!use_key_item(1)
!expect_flag("FLAG_INFINITE_REPEL_ON", 1, "infinite_repel_on")
!walkto(34, 14, "yx")
!walkto(24, 14)
expect32 {gMain+4} {CB2_Overworld+1} in_route29_grass

# Nothing seen yet (the debug-given Cyndaquil is not registered in the Pokedex either), but the
# area's Pokemon are shown, not question marks, and Rattata can be registered
!start_menu("DEXNAV")
wait 120
expect32 {gMain+4} {DexNav_MainCB+1} dexnav_opens
shot 01_dexnav_nothing_seen.png
press RIGHT
wait 20
press R
wait 60
shot 02_dexnav_rattata_registered.png
!expect_var("VAR_DEXNAV_SPECIES", "(ENCOUNTER_TYPE_LAND << 14) | SPECIES_RATTATA", "unseen_rattata_registered")
# B leaves DexNav for the start menu; B again closes it
press B
wait 200
press B
wait 60

# R in the overworld starts the search for the registered species
press R
wait 200
shot 03_dexnav_search.png
!expect_flag("FLAG_DEXNAV_SEARCHING", 1, "r_starts_dexnav_search")
expect16 *{sDexNavSearchDataPtr}+0 19 searching_for_rattata
!walkto("@*{sDexNavSearchDataPtr}+18~7", "@*{sDexNavSearchDataPtr}+20~7", path=True, soft=True)
wait 400
shot 04_dexnav_battle.png
expect32 {gMain+4} {BattleMainCB2+1} dexnav_battle_started
!expect_flag("FLAG_DEXNAV_SEARCHING", 0, "search_ends_at_battle")
press A
wait 300
!expect_battler(1, "species", "SPECIES_RATTATA", "dexnav_rattata")
press R
wait 1000
mash B 2400
expect8 {gPlayerPartyCount} 2 dexnav_rattata_caught
!expect_save3("dexNavSearchLevels[NATIONAL_DEX_RATTATA]", 1, "rattata_search_level_1")
!expect_save3("dexNavChain", 1, "dexnav_chain_1")
