# Crystal Imperium play test for the Elite Four and Lance (tools/crystal_imperium/boss_teams.py),
# at the cap of 56. No team holds items; the autopilot uses one move per Pokemon and never switches,
# so it wins about one try in three. Will and Koga face the prepared six of bosses_m4, Bruno, Karen
# and Lance sixes built for them. Each must be beaten at least once in six tries, and every Mega
# Evolution happens.
!new_game()
!battle_style_set()
savestate base.ss
!prepared_team(56)
savestate prep56.ss

seenreset
!sample_battle("TRAINER_WILL_1_HNS", "0,0,0,0,3,0", 6, 1, 6, "prep56.ss")
!expect_const_seen("SPECIES_ALAKAZAM_MEGA", "will_mega_alakazam")
seenreset
!sample_battle("TRAINER_KOGA_1_HNS", "2,2,1,0,0,0", 6, 1, 6, "prep56.ss")
!expect_const_seen("SPECIES_BEEDRILL_MEGA", "koga_mega_beedrill")

# Bruno: Psychic, Flying, Fire and Ground attackers
loadstate base.ss
!give_mon_complex("SPECIES_GARDEVOIR", 56, "NATURE_MODEST", 0, ["MOVE_MOONBLAST", "MOVE_PSYCHIC", "MOVE_MYSTICAL_FIRE", "MOVE_CALM_MIND"])
!give_mon_complex("SPECIES_TOGEKISS", 56, "NATURE_MODEST", 1, ["MOVE_MOONBLAST", "MOVE_AIR_SLASH", "MOVE_AURA_SPHERE", "MOVE_NASTY_PLOT"])
!give_mon_complex("SPECIES_ESPEON", 56, "NATURE_MODEST", 0, ["MOVE_PSYCHIC", "MOVE_DAZZLING_GLEAM", "MOVE_SHADOW_BALL", "MOVE_CALM_MIND"])
!give_mon_complex("SPECIES_ARCANINE", 56, "NATURE_ADAMANT", 0, ["MOVE_FLARE_BLITZ", "MOVE_EXTREME_SPEED", "MOVE_WILD_CHARGE", "MOVE_CRUNCH"])
!give_mon_complex("SPECIES_GARCHOMP", 56, "NATURE_JOLLY", 1, ["MOVE_EARTHQUAKE", "MOVE_DRAGON_CLAW", "MOVE_FIRE_FANG", "MOVE_SWORDS_DANCE"])
!give_mon_complex("SPECIES_GYARADOS", 56, "NATURE_ADAMANT", 0, ["MOVE_WATERFALL", "MOVE_ICE_FANG", "MOVE_EARTHQUAKE", "MOVE_DRAGON_DANCE"])
savestate bruno56.ss
seenreset
!sample_battle("TRAINER_BRUNO_1_HNS", "1,1,0,0,0,0", 6, 1, 6, "bruno56.ss")
!expect_const_seen("SPECIES_LUCARIO_MEGA", "bruno_mega_lucario")

# Karen: Fairy, Fighting and Rock attackers
loadstate base.ss
!give_mon_complex("SPECIES_TOGEKISS", 56, "NATURE_MODEST", 1, ["MOVE_MOONBLAST", "MOVE_AIR_SLASH", "MOVE_AURA_SPHERE", "MOVE_NASTY_PLOT"])
!give_mon_complex("SPECIES_GARDEVOIR", 56, "NATURE_MODEST", 0, ["MOVE_MOONBLAST", "MOVE_PSYCHIC", "MOVE_MYSTICAL_FIRE", "MOVE_CALM_MIND"])
!give_mon_complex("SPECIES_LUCARIO", 56, "NATURE_ADAMANT", 1, ["MOVE_CLOSE_COMBAT", "MOVE_EXTREME_SPEED", "MOVE_ICE_PUNCH", "MOVE_SWORDS_DANCE"])
!give_mon_complex("SPECIES_TYRANITAR", 56, "NATURE_ADAMANT", 0, ["MOVE_CRUNCH", "MOVE_STONE_EDGE", "MOVE_EARTHQUAKE", "MOVE_DRAGON_DANCE"])
!give_mon_complex("SPECIES_GARCHOMP", 56, "NATURE_JOLLY", 1, ["MOVE_EARTHQUAKE", "MOVE_DRAGON_CLAW", "MOVE_FIRE_FANG", "MOVE_SWORDS_DANCE"])
!give_mon_complex("SPECIES_AMPHAROS", 56, "NATURE_MODEST", 0, ["MOVE_THUNDERBOLT", "MOVE_DRAGON_PULSE", "MOVE_FOCUS_BLAST", "MOVE_POWER_GEM"])
savestate karen56.ss
seenreset
!sample_battle("TRAINER_KAREN_1_HNS", "0,1,0,1,0,0", 6, 1, 6, "karen56.ss")
!expect_const_seen("SPECIES_ABSOL_MEGA", "karen_mega_absol")

# Lance: Fairy and Ice attackers first (the all-round six lost all of its tries)
loadstate base.ss
!give_mon_complex("SPECIES_GARDEVOIR", 56, "NATURE_MODEST", 0, ["MOVE_MOONBLAST", "MOVE_PSYCHIC", "MOVE_MYSTICAL_FIRE", "MOVE_CALM_MIND"])
!give_mon_complex("SPECIES_TOGEKISS", 56, "NATURE_MODEST", 1, ["MOVE_MOONBLAST", "MOVE_AIR_SLASH", "MOVE_AURA_SPHERE", "MOVE_NASTY_PLOT"])
!give_mon_complex("SPECIES_MAMOSWINE", 56, "NATURE_ADAMANT", 1, ["MOVE_ICICLE_CRASH", "MOVE_EARTHQUAKE", "MOVE_ICE_SHARD", "MOVE_STEALTH_ROCK"])
!give_mon_complex("SPECIES_WEAVILE", 56, "NATURE_JOLLY", 0, ["MOVE_TRIPLE_AXEL", "MOVE_KNOCK_OFF", "MOVE_ICE_SHARD", "MOVE_SWORDS_DANCE"])
!give_mon_complex("SPECIES_TYRANITAR", 56, "NATURE_ADAMANT", 0, ["MOVE_CRUNCH", "MOVE_STONE_EDGE", "MOVE_EARTHQUAKE", "MOVE_DRAGON_DANCE"])
!give_mon_complex("SPECIES_AMPHAROS", 56, "NATURE_MODEST", 0, ["MOVE_THUNDERBOLT", "MOVE_DRAGON_PULSE", "MOVE_FOCUS_BLAST", "MOVE_POWER_GEM"])
savestate lance56.ss
seenreset
!sample_battle("TRAINER_LANCE_1_HNS", "0,0,0,0,1,0", 6, 1, 6, "lance56.ss")
!expect_const_seen("SPECIES_GYARADOS_MEGA", "lance_mega_gyarados")
