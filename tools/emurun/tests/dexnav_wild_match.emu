# Crystal Imperium play test: DexNav lists the Pokemon you run into in the wild, the same list at
# every hour and every day (DECISIONS.md D42).
# Route 29 has Pidgey, Sentret and Hoppip by day and Hoothoot and Rattata at night: DexNav lists
# all five at any hour, then the area's six Wild Variety Pokemon (WILD VARIETY at 30%, the
# default), and every wild battle is one of the listed Pokemon. At night, the day's Pokemon turn
# up too. The row is sDexNavUiDataPtr->landSpecies (+6, twelve u16; the water row follows),
# remembered with snap16 while DexNav is open.
# The next day (gSaveBlock2Ptr->localTimeOffset.days one lower) and noon (hours 11 lower) give the
# same list. A Wild Variety Pokemon picked in DexNav (sixth icon) is searched for and battled. A
# mass outbreak on Route 29 is listed too.
!new_game()
!give_mon(155, 5)
!warp(0, 11, 0)
!walkto(34, 14, "yx")
!set_save(2, "localTimeOffset.days", 0, 16)
!l_menu("DEXNAV")
wait 120
shot 01_dexnav_route29.png
!snap_dexnav_rows("day_a")
!expect_listed("*{sDexNavUiDataPtr}+6", 12, "SPECIES_PIDGEY", "day_pokemon_listed_at_night")
!expect_listed("*{sDexNavUiDataPtr}+6", 12, "SPECIES_HOOTHOOT", "night_pokemon_listed_at_night")
expectne16 *{sDexNavUiDataPtr}+26 0 route29_lists_variety_pokemon
expect16 *{sDexNavUiDataPtr}+28 0 five_own_and_six_variety_pokemon
# Rattata, Hoothoot and the six Wild Variety Pokemon: the list without the day's own Pokemon
snap16 not_day *{sDexNavUiDataPtr}+12 8
# The variety pool (sPool, VARIETY_POOL_SIZE entries) holds 445 Pokemon, then 122 legends
expect16 {sPoolCount} 567 variety_pool_size
expect16 {sLegendStart} 445 variety_pool_legends_start
press B
wait 200
press B
wait 60
savestate route29_a.ss
!wild_variety_sample("day_a", 12, state="route29_a.ss", listed="day_a", not_in=(("day_pokemon", "not_day"),))
expecttally day_a 1 12
expecttally day_a_not_listed 0 0
expecttally day_a_day_pokemon 1 12

# The next day: the same list, and the battles are on it
loadstate route29_a.ss
!set_save(2, "localTimeOffset.days", -1, 16)
!l_menu("DEXNAV")
wait 120
shot 02_dexnav_next_day.png
![f"tallynotin changed_on_day_b *{{sDexNavUiDataPtr}}+{6 + 2 * i} @day_a" for i in range(0, 12)]
expecttally changed_on_day_b 0 0
press B
wait 200
press B
wait 60
savestate route29_b.ss
!wild_variety_sample("day_b", 8, state="route29_b.ss", listed="day_a")
expecttally day_b_not_listed 0 0

# Noon of the first day: the same list
loadstate route29_b.ss
!set_save(2, "localTimeOffset.days", 0, 16)
!set_save(2, "localTimeOffset.hours", -11, 8)
!l_menu("DEXNAV")
wait 120
shot 03_dexnav_noon.png
![f"tallynotin changed_at_noon *{{sDexNavUiDataPtr}}+{6 + 2 * i} @day_a" for i in range(0, 12)]
expecttally changed_at_noon 0 0
press B
wait 200
press B
wait 60

# A mass outbreak of Pikachu on Route 29 (map group 0, number 11) is listed, and turns up
loadstate route29_a.ss
!set_save(1, "outbreakPokemonSpecies", "SPECIES_PIKACHU", 16)
!set_save(1, "outbreakLocationMapNum", 11)
!set_save(1, "outbreakLocationMapGroup", 0)
!set_save(1, "outbreakPokemonLevel", 5)
!set_save(1, "outbreakPokemonProbability", 100)
!l_menu("DEXNAV")
wait 120
shot 04_dexnav_outbreak.png
!expect_listed("*{sDexNavUiDataPtr}+6", 12, "SPECIES_PIKACHU", "outbreak_listed")
press B
wait 200
press B
wait 60
!walkto(24, 14, soft=True)
!pace(21, 25, 14, 10, soft=True)
wait 300
shot 05_outbreak_battle.png
!expect_battler(1, "species", "SPECIES_PIKACHU", "outbreak_pikachu")

# Search for a Wild Variety Pokemon from the list (sixth land icon, after the five own ones) and
# battle it. The Infinite Repel keeps random battles away.
loadstate route29_a.ss
!use_key_item(1)
!walkto(24, 14)
!l_menu("DEXNAV")
wait 120
press RIGHT
wait 20
press RIGHT
wait 20
press RIGHT
wait 20
press RIGHT
wait 20
press RIGHT
wait 20
shot 06_variety_pokemon_picked.png
snap16 target *{sDexNavUiDataPtr}+16 1
press A
wait 300
shot 07_variety_search.png
!expect_flag("FLAG_DEXNAV_SEARCHING", 1, "variety_search_started")
tallynotin search_target *{sDexNavSearchDataPtr}+0 @target
expecttally search_target 0 0
!walkto("@*{sDexNavSearchDataPtr}+18~7", "@*{sDexNavSearchDataPtr}+20~7", path=True, soft=True)
wait 400
shot 08_variety_battle.png
expect32 {gMain+4} {BattleMainCB2+1} variety_dexnav_battle
press A
wait 300
tallynotin battle_target {gBattleMons+136} @target
expecttally battle_target 0 0
