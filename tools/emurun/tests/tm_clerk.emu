# Crystal Imperium play test: Emerald Imperium-style TMs (DECISIONS.md D22, D36). Every TM costs
# ¥100, Imperium's price. The Violet City Mart's TM clerk (2,2), talked to across the counter from
# (4,2), sells TMs like every Poke Mart's TM clerk, more with each badge: 71 with no badges, 115
# with the Zephyr Badge. With the badge, the first time, the clerk also gives the four TMs
# Imperium gives away before its second Gym: Bullet Seed, Bulldoze, Bug Bite, Stomping Tantrum.
!new_game()
!max_money()
!expect_item_price("ITEM_TM_ELECTROWEB", 100, "tm_price_100")
!expect_item_price("ITEM_TM_FOCUS_PUNCH", 100, "strongest_tm_price_100")
!warp(3, 1, 0)
!walkto(4, 2)
press LEFT
wait 20

# Before the Zephyr Badge: the shop, no gift
press A
wait 120
shot 01_welcome_no_badge.png
press A
wait 120
press A
wait 90
shot 02_no_badge_list.png
expect16 {sMartInfo+12} 71 no_badge_seventy_one_tms
mash B 300
wait 60
!expect_flag("FLAG_RECEIVED_VIOLET_TMS", 0, "no_gift_without_the_badge")

# With it: the four welcome TMs, then the shop
!set_flag("FLAG_BADGE01_GET")
press A
wait 120
shot 03_gift.png
press A
wait 90
press A
wait 300
shot 04_received.png
press A
wait 90
!expect_flag("FLAG_RECEIVED_VIOLET_TMS", 1, "welcome_tms_given")
!expect_bag_has("TMsHMs", "ITEM_TM_BULLET_SEED", "got_bullet_seed")
!expect_bag_has("TMsHMs", "ITEM_TM_BULLDOZE", "got_bulldoze")
!expect_bag_has("TMsHMs", "ITEM_TM_BUG_BITE", "got_bug_bite")
!expect_bag_has("TMsHMs", "ITEM_TM_STOMPING_TANTRUM", "got_stomping_tantrum")
press A
wait 120
press A
wait 90
shot 05_tm_list.png
expect16 {sMartInfo+12} 115 one_badge_tms_on_sale
# Buy the first, TM03 Flip Turn (quantity 1, confirm)
press A
wait 90
press A
wait 60
press A
wait 90
press A
wait 90
shot 06_bought.png
press A
wait 60
mash B 300
!expect_bag_has("TMsHMs", "ITEM_TM_FLIP_TURN", "bought_flip_turn")

# The gift comes once: the next time it's the shop straight away
press A
wait 120
press A
wait 120
press A
wait 90
shot 07_again.png
expect16 {sMartInfo+12} 115 shop_again
mash B 300
