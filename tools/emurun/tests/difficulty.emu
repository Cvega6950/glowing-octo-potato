# Crystal Imperium play test: the DIFFICULTY option (challenge menu > Difficulty tab).
# Bosses are at the player's level cap on every difficulty (DECISIONS.md D21): Falkner's
# Pidgey / Rookidee / Noctowl are 11 on EASY (NORMAL level caps) and 8 on HARD (the HARD preset
# picks the HARD level caps too). Other trainers' levels are scaled, EASY to 90% and HARD to 110%
# rounded, and are never above the level cap: Youngster Albert's level-7 Sentret and Zubat are 6
# on EASY and 8 on HARD, and Grunt 33's level-20 Koffing (22 on HARD) is held at the cap, 8.
# Each new game is picked in the menu, then each party is read once the battle's action menu is up.
# BattlePokemon: species +0, level +44; the opponent is battler 1 (+136). gEnemyParty: 100 bytes
# a Pokemon, level at +84.

# EASY
!new_game("EASY")
shot 01_easy_overworld.png
!give_mon(155, 11)
savestate easy.ss
!battle("TRAINER_FALKNER_1_HNS")
waituntil32 {gBattlerControllerFuncs} {HandleInputChooseAction@battle_controller_player} 4000 B easy_falkner_action_menu
shot 02_easy_falkner.png
expect16 {gBattleMons+136} 16 falkner_leads_pidgey_easy
expect8 {gBattleMons+180} 11 easy_pidgey_at_cap_11
expect8 {gEnemyParty+184} 11 easy_rookidee_at_cap_11
expect8 {gEnemyParty+284} 11 easy_noctowl_at_cap_11

loadstate easy.ss
!battle("TRAINER_ALBERT_HNS")
waituntil32 {gBattlerControllerFuncs} {HandleInputChooseAction@battle_controller_player} 4000 B easy_albert_action_menu
expect8 {gEnemyParty+84} 6 easy_albert_sentret_at_6
expect8 {gEnemyParty+184} 6 easy_albert_zubat_at_6

# HARD
reset
!new_game("HARD")
!give_mon(155, 11)
savestate hard.ss
!battle("TRAINER_FALKNER_1_HNS")
waituntil32 {gBattlerControllerFuncs} {HandleInputChooseAction@battle_controller_player} 4000 B hard_falkner_action_menu
shot 03_hard_falkner.png
expect16 {gBattleMons+136} 16 falkner_leads_pidgey_hard
expect8 {gBattleMons+180} 8 hard_pidgey_at_cap_8
expect8 {gEnemyParty+184} 8 hard_rookidee_at_cap_8
expect8 {gEnemyParty+284} 8 hard_noctowl_at_cap_8

loadstate hard.ss
!battle("TRAINER_ALBERT_HNS")
waituntil32 {gBattlerControllerFuncs} {HandleInputChooseAction@battle_controller_player} 4000 B hard_albert_action_menu
expect8 {gEnemyParty+84} 8 hard_albert_sentret_at_8
expect8 {gEnemyParty+184} 8 hard_albert_zubat_at_8

loadstate hard.ss
!battle("TRAINER_GRUNT_33_HNS")
waituntil32 {gBattlerControllerFuncs} {HandleInputChooseAction@battle_controller_player} 4000 B hard_grunt_action_menu
shot 04_hard_grunt.png
expect8 {gEnemyParty+84} 8 hard_grunt_koffing_held_at_cap_8
