# Platinum Imperium play test: Crystal Imperium's L menu and key items in Twinleaf Town.
# No L menu without a Pokemon; with one, L opens POKeVIAL, PC, DEXNAV, TIME, STATS and the REPEL
# and AUTO RUN switches (no FOLLOWER: this game has no follower Pokemon). The key items are in
# the Bag from the start.
!new_game()
!expect_bag_has("keyItems", "ITEM_INFINITE_RARE_CANDIES")
!expect_bag_has("keyItems", "ITEM_INFINITE_REPEL")
!expect_bag_has("keyItems", "ITEM_POKEMON_BOX_LINK")
!expect_bag_has("keyItems", "ITEM_TRAINING_KIT")
!expect_bag_has("keyItems", "ITEM_POKE_VIAL")
!expect_flag("FLAG_SYS_DEXNAV_GET", 1, "dexnav_from_the_start")
press L
wait 40
shot 01_no_l_menu_without_a_pokemon.png
expect8 {sNumLMenuActions} 0 no_l_menu_without_a_pokemon
!give_mon(387, 5)
press L
wait 40
shot 02_l_menu.png
expect8 {sNumLMenuActions} 7 seven_entries
# AUTO RUN is on from the challenge menu: the switch turns it off and on
!l_menu("AUTO_RUN", open=False)
!expect_auto_run(False, "auto_run_switched_off")
!l_menu("AUTO_RUN", open=False)
!expect_auto_run(True, "auto_run_switched_on")
# REPEL switches the Infinite Repel
!l_menu("REPEL", open=False)
!expect_flag("FLAG_INFINITE_REPEL_ON", 1, "infinite_repel_on")
shot 03_switches.png
# POKeVIAL heals the party (the Turtwig is hurt first)
press B
wait 40
poke16 {gPlayerParty+86} 1
press L
wait 40
!l_menu("POKEVIAL", open=False)
mash A 200
expectne16 {gPlayerParty+86} 1 pokevial_healed
