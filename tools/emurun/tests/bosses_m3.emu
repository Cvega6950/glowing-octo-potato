# Crystal Imperium smoke test for the Imperium-style bosses (tools/crystal_imperium/boss_teams.py):
# every reworked battle loads and plays to a result (win or loss) against the real AI. Proton 1,
# the rival in Azalea and at the Burned Tower (one starter version each), Morty, every version of
# Chuck, Jasmine and Pryce (5th, 6th and 7th Gym), and Clair. The player's team is at the level
# cap for that battle; which side wins doesn't matter here (the naive team usually loses).
!new_game()
!battle_style_set()
savestate base.ss

# Proton in Slowpoke Well (cap 16)
!team(16, "SPECIES_QUILAVA", "SPECIES_CROCONAW", "SPECIES_FLAAFFY")
!battle("TRAINER_PROTON_1_HNS")
!autobattle("1,0,2")
expectne8 {gBattleOutcome} 0 proton_1_resolved

# Rival in Azalea (cap 21) and at the Burned Tower (cap 25)
loadstate base.ss
!team(21, "SPECIES_QUILAVA", "SPECIES_CROCONAW", "SPECIES_FLAAFFY")
savestate lv21.ss
!battle("TRAINER_RIVAL_CYNDAQUIL_2_HNS")
!autobattle("1,0,2")
expectne8 {gBattleOutcome} 0 rival_2_resolved
loadstate base.ss
!team(25, "SPECIES_FERALIGATR", "SPECIES_TYPHLOSION", "SPECIES_GYARADOS")
savestate lv25.ss
!battle("TRAINER_RIVAL_TOTODILE_3_HNS")
!autobattle("0,1,3")
expectne8 {gBattleOutcome} 0 rival_3_resolved

# Morty (cap 25)
loadstate lv25.ss
!battle("TRAINER_MORTY_1_HNS")
!autobattle("0,1,3")
expectne8 {gBattleOutcome} 0 morty_resolved

# Chuck, Jasmine, Pryce as the 5th Gym (cap 31)
loadstate base.ss
!team(31, "SPECIES_FERALIGATR", "SPECIES_GARDEVOIR", "SPECIES_GYARADOS", "SPECIES_TYPHLOSION")
savestate lv31.ss
!battle("TRAINER_CHUCK_1_HNS")
!autobattle("2,3,3,3")
expectne8 {gBattleOutcome} 0 chuck_1_resolved
loadstate lv31.ss
!battle("TRAINER_JASMINE_1_HNS")
!autobattle("2,3,3,3")
expectne8 {gBattleOutcome} 0 jasmine_1_resolved
loadstate lv31.ss
!battle("TRAINER_PRYCE_1_HNS")
!autobattle("2,3,3,3")
expectne8 {gBattleOutcome} 0 pryce_1_resolved

# ... as the 6th Gym (cap 36)
loadstate base.ss
!team(36, "SPECIES_FERALIGATR", "SPECIES_GARDEVOIR", "SPECIES_GYARADOS", "SPECIES_AMPHAROS")
savestate lv36.ss
!battle("TRAINER_CHUCK_1_2_HNS")
!autobattle("2,2,1,0")
expectne8 {gBattleOutcome} 0 chuck_2_resolved
loadstate lv36.ss
!battle("TRAINER_JASMINE_1_2_HNS")
!autobattle("2,2,1,0")
expectne8 {gBattleOutcome} 0 jasmine_2_resolved
loadstate lv36.ss
!battle("TRAINER_PRYCE_1_2_HNS")
!autobattle("2,2,1,0")
expectne8 {gBattleOutcome} 0 pryce_2_resolved

# ... as the 7th Gym (cap 38)
loadstate base.ss
!team(38, "SPECIES_FERALIGATR", "SPECIES_GARDEVOIR", "SPECIES_GYARADOS", "SPECIES_AMPHAROS")
savestate lv38.ss
!battle("TRAINER_CHUCK_1_3_HNS")
!autobattle("2,2,1,0")
expectne8 {gBattleOutcome} 0 chuck_3_resolved
loadstate lv38.ss
!battle("TRAINER_JASMINE_1_3_HNS")
!autobattle("2,2,1,0")
expectne8 {gBattleOutcome} 0 jasmine_3_resolved
loadstate lv38.ss
!battle("TRAINER_PRYCE_1_3_HNS")
!autobattle("2,2,1,0")
expectne8 {gBattleOutcome} 0 pryce_3_resolved

# Clair (cap 45)
loadstate base.ss
!team(45, "SPECIES_GARDEVOIR", "SPECIES_FERALIGATR", "SPECIES_AMPHAROS", "SPECIES_TYPHLOSION", "SPECIES_GYARADOS")
!battle("TRAINER_CLAIR_1_HNS")
!autobattle("0,1,3,3,1")
expectne8 {gBattleOutcome} 0 clair_resolved

# Winnable with a well-built team: six fully evolved Pokemon at the cap with good natures and
# moves but no held items (prepared_team), played by the autopilot (one move per Pokemon, no
# switching), wins at least once: in eight tries, sixteen against Pryce (it won 5, 6, 6, 3 and 4 of
# 8 against Morty, Chuck, Jasmine, Pryce and Clair when the tries were sized). The bosses' Mega
# Evolutions happen.
loadstate base.ss
!prepared_team(25)
savestate prep25.ss
!sample_battle("TRAINER_MORTY_1_HNS", "0,0,1,0,3,0", 8, 1, 8, "prep25.ss")
loadstate base.ss
!prepared_team(31)
savestate prep31.ss
seenreset
!sample_battle("TRAINER_CHUCK_1_HNS", "1,0,1,0,0,0", 8, 1, 8, "prep31.ss")
!expect_const_seen("SPECIES_HERACROSS_MEGA", "chuck_mega_heracross")
seenreset
!sample_battle("TRAINER_JASMINE_1_HNS", "1,2,2,0,0,2", 8, 1, 8, "prep31.ss")
!expect_const_seen("SPECIES_STEELIX_MEGA", "jasmine_mega_steelix")
seenreset
!sample_battle("TRAINER_PRYCE_1_HNS", "1,0,2,1,0,2", 16, 1, 16, "prep31.ss")
!expect_const_seen("SPECIES_ABOMASNOW_MEGA", "pryce_mega_abomasnow")
loadstate base.ss
!prepared_team(45)
savestate prep45.ss
seenreset
!sample_battle("TRAINER_CLAIR_1_HNS", "1,1,0,1,3,1", 8, 1, 8, "prep45.ss")
!expect_const_seen("SPECIES_ALTARIA_MEGA", "clair_mega_altaria")
