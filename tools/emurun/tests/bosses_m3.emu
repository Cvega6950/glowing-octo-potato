# Crystal Imperium smoke test for the Imperium-style bosses (tools/crystal_imperium/boss_teams.py):
# every reworked battle loads and plays to a result (win or loss) against the real AI. Proton 1,
# the rival in Azalea and at the Burned Tower (one starter version each), Morty, every version of
# Chuck, Jasmine and Pryce (5th, 6th and 7th Gym), and Clair. The player's team is at the level
# cap for that battle; which side wins doesn't matter here (the naive team usually loses).
!new_game()
!battle_style_set()
savestate base.ss

# Proton in Slowpoke Well (cap 16)
!team(16, "SPECIES_QUILAVA", "SPECIES_CROCONAW", "SPECIES_FLAAFFY")
!battle("TRAINER_PROTON_1_HNS")
!autobattle("1,0,2")
expectne8 {gBattleOutcome} 0 proton_1_resolved

# Rival in Azalea (cap 21) and at the Burned Tower (cap 25)
loadstate base.ss
!team(21, "SPECIES_QUILAVA", "SPECIES_CROCONAW", "SPECIES_FLAAFFY")
savestate lv21.ss
!battle("TRAINER_RIVAL_CYNDAQUIL_2_HNS")
!autobattle("1,0,2")
expectne8 {gBattleOutcome} 0 rival_2_resolved
loadstate base.ss
!team(25, "SPECIES_FERALIGATR", "SPECIES_TYPHLOSION", "SPECIES_GYARADOS")
savestate lv25.ss
!battle("TRAINER_RIVAL_TOTODILE_3_HNS")
!autobattle("0,1,3")
expectne8 {gBattleOutcome} 0 rival_3_resolved

# Morty (cap 25)
loadstate lv25.ss
!battle("TRAINER_MORTY_1_HNS")
!autobattle("0,1,3")
expectne8 {gBattleOutcome} 0 morty_resolved

# Chuck, Jasmine, Pryce as the 5th Gym (cap 31)
loadstate base.ss
!team(31, "SPECIES_FERALIGATR", "SPECIES_GARDEVOIR", "SPECIES_GYARADOS", "SPECIES_TYPHLOSION")
savestate lv31.ss
!battle("TRAINER_CHUCK_1_HNS")
!autobattle("2,3,3,3")
expectne8 {gBattleOutcome} 0 chuck_1_resolved
loadstate lv31.ss
!battle("TRAINER_JASMINE_1_HNS")
!autobattle("2,3,3,3")
expectne8 {gBattleOutcome} 0 jasmine_1_resolved
loadstate lv31.ss
!battle("TRAINER_PRYCE_1_HNS")
!autobattle("2,3,3,3")
expectne8 {gBattleOutcome} 0 pryce_1_resolved

# ... as the 6th Gym (cap 36)
loadstate base.ss
!team(36, "SPECIES_FERALIGATR", "SPECIES_GARDEVOIR", "SPECIES_GYARADOS", "SPECIES_AMPHAROS")
savestate lv36.ss
!battle("TRAINER_CHUCK_1_2_HNS")
!autobattle("2,2,1,0")
expectne8 {gBattleOutcome} 0 chuck_2_resolved
loadstate lv36.ss
!battle("TRAINER_JASMINE_1_2_HNS")
!autobattle("2,2,1,0")
expectne8 {gBattleOutcome} 0 jasmine_2_resolved
loadstate lv36.ss
!battle("TRAINER_PRYCE_1_2_HNS")
!autobattle("2,2,1,0")
expectne8 {gBattleOutcome} 0 pryce_2_resolved

# ... as the 7th Gym (cap 38)
loadstate base.ss
!team(38, "SPECIES_FERALIGATR", "SPECIES_GARDEVOIR", "SPECIES_GYARADOS", "SPECIES_AMPHAROS")
savestate lv38.ss
!battle("TRAINER_CHUCK_1_3_HNS")
!autobattle("2,2,1,0")
expectne8 {gBattleOutcome} 0 chuck_3_resolved
loadstate lv38.ss
!battle("TRAINER_JASMINE_1_3_HNS")
!autobattle("2,2,1,0")
expectne8 {gBattleOutcome} 0 jasmine_3_resolved
loadstate lv38.ss
!battle("TRAINER_PRYCE_1_3_HNS")
!autobattle("2,2,1,0")
expectne8 {gBattleOutcome} 0 pryce_3_resolved

# Clair (cap 45)
loadstate base.ss
!team(45, "SPECIES_GARDEVOIR", "SPECIES_FERALIGATR", "SPECIES_AMPHAROS", "SPECIES_TYPHLOSION", "SPECIES_GYARADOS")
!battle("TRAINER_CLAIR_1_HNS")
!autobattle("0,1,3,3,1")
expectne8 {gBattleOutcome} 0 clair_resolved

# Winnable with a well-built team. Since 0.7.0 every boss Pokemon is at the cap, and the player's
# teams hold items from the care packages they have by then (DECISIONS.md D16). Morty, Jasmine
# and Clair face the prepared six (prepared_team with items: Life Orb, Leftovers, Choice Specs,
# Focus Sash, Choice Band, Expert Belt), played naively (one move per Pokemon, no switching). The
# prepared six beat Pryce only 1 time in 16 even with items and a game plan (0 in 16 without), so
# Chuck and Pryce face sixes built for them, played with a game plan like the Elite Four's
# (bosses_e4): they won 16 of 16 and 13 of 16 when built. Each Gym Leader must be beaten at least
# once in eight tries (Clair sixteen), and every boss Mega Evolution happens.
loadstate base.ss
!prepared_team(25, items=True)
savestate prep25.ss
!sample_battle("TRAINER_MORTY_1_HNS", "0,0,1,0,3,0", 8, 1, 8, "prep25.ss")
loadstate base.ss
!prepared_team(31, items=True)
savestate prep31.ss
seenreset
!sample_battle("TRAINER_JASMINE_1_HNS", "1,2,2,0,0,2", 8, 1, 8, "prep31.ss")
!expect_const_seen("SPECIES_STEELIX_MEGA", "jasmine_mega_steelix")

# Chuck: Psychic, Flying and Fairy attackers (Talonflame with a Lum Berry against Breloom's Spore)
loadstate base.ss
!give_mon_complex("SPECIES_GARDEVOIR", 31, "NATURE_MODEST", 0, ['MOVE_PSYCHIC', 'MOVE_MOONBLAST', 'MOVE_MYSTICAL_FIRE', 'MOVE_CALM_MIND'])
!give_mon_complex("SPECIES_TALONFLAME", 31, "NATURE_ADAMANT", 1, ['MOVE_BRAVE_BIRD', 'MOVE_FLARE_BLITZ', 'MOVE_U_TURN', 'MOVE_ROOST'])
!give_mon_complex("SPECIES_TOGEKISS", 31, "NATURE_MODEST", 1, ['MOVE_AIR_SLASH', 'MOVE_MOONBLAST', 'MOVE_AURA_SPHERE', 'MOVE_NASTY_PLOT'])
!give_mon_complex("SPECIES_SLOWBRO", 31, "NATURE_MODEST", 0, ['MOVE_PSYCHIC', 'MOVE_SCALD', 'MOVE_ICE_BEAM', 'MOVE_SLACK_OFF'])
!give_mon_complex("SPECIES_GENGAR", 31, "NATURE_TIMID", 0, ['MOVE_SHADOW_BALL', 'MOVE_SLUDGE_BOMB', 'MOVE_FOCUS_BLAST', 'MOVE_NASTY_PLOT'])
!give_mon_complex("SPECIES_ALAKAZAM", 31, "NATURE_TIMID", 0, ['MOVE_PSYCHIC', 'MOVE_SHADOW_BALL', 'MOVE_FOCUS_BLAST', 'MOVE_CALM_MIND'])
!hold_item("ITEM_LIFE_ORB", 0)
!hold_item("ITEM_LUM_BERRY", 1, "POCKET_BERRIES")
!hold_item("ITEM_LEFTOVERS", 2)
!hold_item("ITEM_ASSAULT_VEST", 3)
!hold_item("ITEM_FOCUS_SASH", 4)
!hold_item("ITEM_FOCUS_SASH", 5)
savestate chuck31.ss
seenreset
!sample_battle("TRAINER_CHUCK_1_HNS", "0,0,0,0,0,0", 8, 1, 8, "chuck31.ss", plan={"SPECIES_HITMONTOP": [(0, 0), (2, 0), (5, 0)], "SPECIES_BRELOOM": [(1, 0), (2, 0), (0, 0)], "SPECIES_PRIMEAPE": [(0, 1), (2, 0), (5, 0)], "SPECIES_POLIWRATH": [(0, 0), (2, 0), (5, 0)], "SPECIES_HERACROSS": [(1, 0), (2, 0)], "SPECIES_HERACROSS_MEGA": [(1, 0), (2, 0)]})
!expect_const_seen("SPECIES_HERACROSS_MEGA", "chuck_mega_heracross")

# Pryce: Electric for Cloyster, Dark for Jynx, Fighting for Weavile, Water for Mamoswine, Fire
# and Steel for Abomasnow (Assault Vest Magnezone and Tyranitar, Focus Sash Lucario, Choice
# Band Arcanine, which only uses Flare Blitz)
loadstate base.ss
!give_mon_complex("SPECIES_MAGNEZONE", 31, "NATURE_MODEST", 0, ['MOVE_THUNDERBOLT', 'MOVE_FLASH_CANNON', 'MOVE_VOLT_SWITCH', 'MOVE_BODY_PRESS'])
!give_mon_complex("SPECIES_LUCARIO", 31, "NATURE_ADAMANT", 1, ['MOVE_CLOSE_COMBAT', 'MOVE_METEOR_MASH', 'MOVE_EXTREME_SPEED', 'MOVE_SWORDS_DANCE'])
!give_mon_complex("SPECIES_ARCANINE", 31, "NATURE_ADAMANT", 0, ['MOVE_FLARE_BLITZ', 'MOVE_EXTREME_SPEED', 'MOVE_WILD_CHARGE', 'MOVE_CRUNCH'])
!give_mon_complex("SPECIES_GYARADOS", 31, "NATURE_ADAMANT", 0, ['MOVE_WATERFALL', 'MOVE_ICE_FANG', 'MOVE_EARTHQUAKE', 'MOVE_DRAGON_DANCE'])
!give_mon_complex("SPECIES_TYRANITAR", 31, "NATURE_ADAMANT", 0, ['MOVE_CRUNCH', 'MOVE_STONE_EDGE', 'MOVE_EARTHQUAKE', 'MOVE_DRAGON_DANCE'])
!give_mon_complex("SPECIES_METAGROSS", 31, "NATURE_ADAMANT", 0, ['MOVE_METEOR_MASH', 'MOVE_ZEN_HEADBUTT', 'MOVE_BULLET_PUNCH', 'MOVE_EARTHQUAKE'])
!hold_item("ITEM_ASSAULT_VEST", 0)
!hold_item("ITEM_FOCUS_SASH", 1)
!hold_item("ITEM_CHOICE_BAND", 2)
!hold_item("ITEM_LEFTOVERS", 3)
!hold_item("ITEM_ASSAULT_VEST", 4)
!hold_item("ITEM_LIFE_ORB", 5)
savestate pryce31.ss
seenreset
!sample_battle("TRAINER_PRYCE_1_HNS", "0,0,0,0,0,0", 8, 1, 8, "pryce31.ss", plan={"SPECIES_CLOYSTER": [(0, 0), (1, 0)], "SPECIES_JYNX": [(4, 0), (5, 0)], "SPECIES_WEAVILE": [(1, 0), (2, 0), (5, 0)], "SPECIES_MAMOSWINE": [(3, 0), (1, 0)], "SPECIES_ABOMASNOW": [(2, 0), (5, 0), (0, 1), (1, 0)], "SPECIES_ABOMASNOW_MEGA": [(2, 0), (5, 0), (0, 1), (1, 0)]})
!expect_const_seen("SPECIES_ABOMASNOW_MEGA", "pryce_mega_abomasnow")

loadstate base.ss
!prepared_team(45, items=True)
savestate prep45.ss
seenreset
!sample_battle("TRAINER_CLAIR_1_HNS", "1,1,0,1,3,1", 16, 1, 16, "prep45.ss")
!expect_const_seen("SPECIES_ALTARIA_MEGA", "clair_mega_altaria")
