# Crystal Imperium play test: Emerald Imperium's and Radical Red's move pools (DECISIONS.md D39),
# checked in the party menu's move relearner and in a battle. With every TM and HM in the Bag:
# - TYPHLOSION learns what Radical Red teaches it: Aura Sphere and Mystical Fire by TM, Blast Burn
#   by tutor, but not Shadow Ball (a TM) or Body Slam (a tutor move), which Scarlet and Violet
#   teach it;
# - MEW's TM list has all 206 TMs and HMs (more than the 60 the relearner's list held before
#   0.13.0: the rest overflowed it), and its tutor list 61 moves, then 63 once the game is
#   cleared: Dark Hole and Draco Barrage, Emerald Imperium's postgame TMs, wait until then;
# - DRAGONITE's tutor list has Draco Barrage once the game is cleared; it learns it, and in battle
#   knocks out Whitney's Fairy-type CLEFAIRY (99 HP, Eviolite) with it: Draco Barrage hits
#   Fairy-types, and with DRAGONITE's Attack above its Sp. Atk it is physical (117-138 damage;
#   special, 79-93). The user takes a third of the 99 HP as recoil;
# - TERAPAGOS learns what Radical Red's Terapagos (its Terastal Form) does: Hyper Voice by TM, not
#   Solar Beam or Power Gem.
# Each list is checked against the build's own teachable learnsets (relearner_list).
!new_game()
!no_care_packages()
# BATTLE STYLE SET: no "Will you switch?" after the knockout
!battle_style_set()
!fill_tm_case()
!give_mon_complex("SPECIES_DRAGONITE", 50, "NATURE_HARDY", 0, ["MOVE_EXTREME_SPEED", "MOVE_WING_ATTACK", "MOVE_SLAM", "MOVE_WRAP"])
!give_mon_complex("SPECIES_MEW", 50, "NATURE_HARDY", 0, ["MOVE_POUND", "MOVE_TRANSFORM", "MOVE_AMNESIA", "MOVE_BARRIER"])
!give_mon_complex("SPECIES_TYPHLOSION", 50, "NATURE_HARDY", 0, ["MOVE_ERUPTION", "MOVE_LAVA_PLUME", "MOVE_QUICK_ATTACK", "MOVE_SMOKESCREEN"])
!give_mon_complex("SPECIES_TERAPAGOS", 50, "NATURE_HARDY", 0, ["MOVE_TACKLE", "MOVE_WITHDRAW", "MOVE_RAPID_SPIN", "MOVE_PROTECT"])

# TYPHLOSION (slot 2: LEVEL UP, EGG, TM, TUTOR)
!open_relearner(2, 2, "MOVE_RELEARNER_TM_MOVES", "typhlosion_tm")
shot 01_typhlosion_tm.png
!expect_relearner_list("Typhlosion", "MOVE_RELEARNER_TM_MOVES", ("MOVE_ERUPTION", "MOVE_LAVA_PLUME", "MOVE_QUICK_ATTACK", "MOVE_SMOKESCREEN"), present=("MOVE_AURA_SPHERE", "MOVE_MYSTICAL_FIRE"), absent=("MOVE_SHADOW_BALL",), label="typhlosion_tm")
!close_relearner()
!open_relearner(2, 3, "MOVE_RELEARNER_TUTOR_MOVES", "typhlosion_tutor")
!expect_relearner_list("Typhlosion", "MOVE_RELEARNER_TUTOR_MOVES", ("MOVE_ERUPTION", "MOVE_LAVA_PLUME", "MOVE_QUICK_ATTACK", "MOVE_SMOKESCREEN"), present=("MOVE_BLAST_BURN",), absent=("MOVE_BODY_SLAM",), label="typhlosion_tutor")
!close_relearner()

# TERAPAGOS (slot 3: LEVEL UP, TM, TUTOR): Radical Red has only its Terastal Form, whose list it
# takes: Hyper Voice, not Solar Beam or Power Gem (official ones Radical Red doesn't teach it)
!open_relearner(3, 1, "MOVE_RELEARNER_TM_MOVES", "terapagos_tm")
!expect_relearner_list("Terapagos", "MOVE_RELEARNER_TM_MOVES", ("MOVE_TACKLE", "MOVE_WITHDRAW", "MOVE_RAPID_SPIN", "MOVE_PROTECT"), present=("MOVE_HYPER_VOICE",), absent=("MOVE_SOLAR_BEAM", "MOVE_POWER_GEM"), label="terapagos_tm")
!close_relearner()

# MEW (slot 1: LEVEL UP, TM, TUTOR; no Egg Moves)
!open_relearner(1, 1, "MOVE_RELEARNER_TM_MOVES", "mew_tm")
shot 02_mew_tm.png
!expect_relearner_list("Mew", "MOVE_RELEARNER_TM_MOVES", ("MOVE_POUND", "MOVE_TRANSFORM", "MOVE_AMNESIA", "MOVE_BARRIER"), present=("MOVE_FOCUS_PUNCH", "MOVE_WHIRLPOOL"), label="mew_tm")
!close_relearner()
!open_relearner(1, 2, "MOVE_RELEARNER_TUTOR_MOVES", "mew_tutor")
!expect_relearner_list("Mew", "MOVE_RELEARNER_TUTOR_MOVES", ("MOVE_POUND", "MOVE_TRANSFORM", "MOVE_AMNESIA", "MOVE_BARRIER"), present=("MOVE_COSMIC_POWER", "MOVE_WORK_UP"), absent=("MOVE_BLAST_BURN", "MOVE_DARK_HOLE", "MOVE_DRACO_BARRAGE"), label="mew_tutor_before_game_clear")
!close_relearner()

# DRAGONITE (slot 0: LEVEL UP, EGG, TM, TUTOR): no Draco Barrage yet
!open_relearner(0, 3, "MOVE_RELEARNER_TUTOR_MOVES", "dragonite_tutor")
!expect_relearner_list("Dragonite", "MOVE_RELEARNER_TUTOR_MOVES", ("MOVE_EXTREME_SPEED", "MOVE_WING_ATTACK", "MOVE_SLAM", "MOVE_WRAP"), absent=("MOVE_DRACO_BARRAGE",), label="dragonite_tutor_before_game_clear")
!close_relearner()

# The game cleared: MEW's tutor list has both, and DRAGONITE learns Draco Barrage in place of
# EXTREME SPEED (the flow of relearner_training_kit.emu)
!set_flag("FLAG_SYS_GAME_CLEAR")
!open_relearner(1, 2, "MOVE_RELEARNER_TUTOR_MOVES", "mew_tutor_game_clear")
!expect_relearner_list("Mew", "MOVE_RELEARNER_TUTOR_MOVES", ("MOVE_POUND", "MOVE_TRANSFORM", "MOVE_AMNESIA", "MOVE_BARRIER"), present=("MOVE_DARK_HOLE", "MOVE_DRACO_BARRAGE"), label="mew_tutor_after_game_clear", game_clear=True)
!close_relearner()
!open_relearner(0, 3, "MOVE_RELEARNER_TUTOR_MOVES", "dragonite_tutor_game_clear")
!expect_relearner_list("Dragonite", "MOVE_RELEARNER_TUTOR_MOVES", ("MOVE_EXTREME_SPEED", "MOVE_WING_ATTACK", "MOVE_SLAM", "MOVE_WRAP"), present=("MOVE_DRACO_BARRAGE",), label="dragonite_tutor_after_game_clear", game_clear=True)
!relearner_index("Dragonite", "MOVE_RELEARNER_TUTOR_MOVES", ("MOVE_EXTREME_SPEED", "MOVE_WING_ATTACK", "MOVE_SLAM", "MOVE_WRAP"), "MOVE_DRACO_BARRAGE", game_clear=True)
shot 03_draco_barrage.png
press A
wait 60
press A
wait 200
press A
wait 60
press A
wait 60
press A
wait 60
press A
wait 120
shot 04_forget.png
press A
waituntil32 {gMain+4} {CB2_UpdatePartyMenu} 3000 A back_in_party_menu
mash B 120
wait 60

!battle_trainer(406)
!wait_action_menu("whitney_menu", 3000)
!expect_battler(0, "moves[0]", "MOVE_DRACO_BARRAGE", "dragonite_learned_draco_barrage")
!expect_battler(1, "species", "SPECIES_CLEFAIRY", "whitney_leads_with_clefairy")
!expect_battler(0, "hp", "166", "dragonite_at_full_hp")
press A
wait 20
press A
!wait_action_menu("next_turn", 3000)
shot 05_after_draco_barrage.png
expect16 {gEnemyParty+86} 0 clefairy_knocked_out_by_draco_barrage
# Recoil: a third of the 99 HP CLEFAIRY lost, rounded down
!expect_battler(0, "hp", "134", "dragonite_took_32_recoil")
