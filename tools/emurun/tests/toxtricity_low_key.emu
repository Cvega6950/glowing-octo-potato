# Crystal Imperium play test: a Low Key Toxtricity stays Low Key after a battle (DECISIONS.md D58).
# pokeemerald-expansion gave the Low Key forms Amped Toxtricity's form changes, so every Low Key
# Toxtricity in the party, sent out or not, came out of each battle as an Amped Toxtricity.
!new_game()
!battle_style_set()
# Level 50: two Low Key Toxtricity (Serious, a Low Key nature), the first battles and the second
# stays in the party, and an Amped one (Hardy), which stays Amped
!give_mon_complex("SPECIES_TOXTRICITY_LOW_KEY", 50, "NATURE_SERIOUS", 0, ["MOVE_OVERDRIVE", "MOVE_SLUDGE_BOMB", "MOVE_BOOMBURST", "MOVE_SHIFT_GEAR"])
!give_mon_complex("SPECIES_TOXTRICITY_LOW_KEY", 50, "NATURE_SERIOUS", 0, ["MOVE_OVERDRIVE", "MOVE_SLUDGE_BOMB", "MOVE_BOOMBURST", "MOVE_SHIFT_GEAR"])
!give_mon_complex("SPECIES_TOXTRICITY_AMPED", 50, "NATURE_HARDY", 0, ["MOVE_OVERDRIVE", "MOVE_SLUDGE_BOMB", "MOVE_BOOMBURST", "MOVE_SHIFT_GEAR"])
!expect_party_species("gPlayerParty", 0, "SPECIES_TOXTRICITY_LOW_KEY", "lead_is_low_key")
!expect_party_species("gPlayerParty", 1, "SPECIES_TOXTRICITY_LOW_KEY", "second_is_low_key")
!expect_party_species("gPlayerParty", 2, "SPECIES_TOXTRICITY_AMPED", "third_is_amped")
!battle("TRAINER_FALKNER_1_HNS")
!wait_action_menu("toxtricity_action_menu")
shot 01_low_key_battles.png
!expect_battler(0, "species", "SPECIES_TOXTRICITY_LOW_KEY", "battles_as_low_key")
# Falkner's Pokemon at 1 HP: the battle is won whatever its luck
!weaken_opponents(6)
!autobattle("0")
expect8 {gBattleOutcome} 1 falkner_beaten
!expect_party_species("gPlayerParty", 0, "SPECIES_TOXTRICITY_LOW_KEY", "lead_still_low_key")
!expect_party_species("gPlayerParty", 1, "SPECIES_TOXTRICITY_LOW_KEY", "second_still_low_key")
!expect_party_species("gPlayerParty", 2, "SPECIES_TOXTRICITY_AMPED", "third_still_amped")
# The party menu once back in the overworld: two Low Key Toxtricity and an Amped one
wait 300
!start_menu("POKEMON")
wait 60
shot 02_party_after_battle.png
mash B 120
