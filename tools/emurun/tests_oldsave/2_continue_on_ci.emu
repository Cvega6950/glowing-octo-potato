# Crystal Imperium (run by old_save_test.sh): Continue the Heart & Soul 2.0.6 save
wait 1300
press START
wait 120
press A
wait 100
press A
wait 900
shot 03_ci_continue.png
expect8 {gPlayerPartyCount} 1 party_kept
!expect_bag_has("keyItems", "ITEM_INFINITE_RARE_CANDIES")
!expect_bag_has("keyItems", "ITEM_POKE_VIAL")
!expect_bag_has("keyItems", "ITEM_TRAINING_KIT")
!expect_bag_has("keyItems", "ITEM_INFINITE_REPEL")
!expect_bag_has("keyItems", "ITEM_POKEMON_BOX_LINK")
!expect_flag("FLAG_SYS_DEXNAV_GET", 1, "dexnav_given")
!expect_save3("dexNavSearchLevels[NATIONAL_DEX_RATTATA]", 0, "search_levels_zero")
# The TMs keep their moves: Heart & Soul's TM70 Rock Climb is TM192 now and TM03 Water Pulse is
# TM160 (TM70 is Triple Axel and TM03 Flip Turn). They move from SaveBlock1's bag to the TM case.
!expect_bag_has("TMsHMs", "ITEM_TM_ROCK_CLIMB", "old_tm70_is_rock_climb")
!expect_bag_has("TMsHMs", "ITEM_TM_WATER_PULSE", "old_tm03_is_water_pulse")
!expect_bag_has("TMsHMs", "ITEM_HM_CUT", "old_hm01_kept")
!expect_save3("tmHmPocketVersion", 1, "case_version_set")
!expect_save3("tmHmCounts[191]", 1, "count_tm192_rock_climb", size=16)
!expect_save3("tmHmCounts[69]", 0, "no_triple_axel", size=16)
!expect_save3("tmHmCounts[2]", 0, "no_flip_turn", size=16)
!["expect16 *{gSaveBlock1Ptr}+" + str(probe.resolve({"o": "offsetof(struct SaveBlock1, bag.TMsHMs)"})["o"]) + " 0 old_tm_slots_cleared"]
# The clock window shown after Continue closes on its own; DexNav opens where there are wild
# Pokemon (not in the bedroom), so warp to Route 29
wait 400
!warp(0, 11, 0)
!start_menu("DEXNAV")
wait 120
shot 04_ci_dexnav.png
expect32 {gMain+4} {DexNav_MainCB+1} dexnav_opens_on_old_save
