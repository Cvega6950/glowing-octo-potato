# Heart & Soul 2.0.6 (run by old_save_test.sh): new game, a Pokemon and TMs from the debug menu, save
# (place_packages=True: nothing of Crystal Imperium's care packages is written to this save)
!new_game(place_packages=True)
!give_mon(155, 5)
# Heart & Soul numbering: TM70 is Rock Climb and TM03 Water Pulse (Crystal Imperium renumbers them)
!give_item("ITEM_TM70")
!give_item("ITEM_TM03")
!give_item("ITEM_HM01")
expect8 {gPlayerPartyCount} 1 hns_party
# Heart & Soul's new game has FAST INTRO off (Crystal Imperium turns it on for this save, D38)
!expect_challenge_bit("fastIntro", 1, "hns_fast_intro_off")
!start_menu("SAVE")
shot 01_hns_save_prompt.png
press A
wait 400
mash A 300
shot 02_hns_saved.png
