@ Generated by tools/crystal_imperium/tm_list.py: the TM shops (DECISIONS.md D36), the TM clerk in
@ every Poke Mart and the Goldenrod Dept. Store 5F. One list per badge count (the 8th: every TM),
@ each with the TMs the badges so far unlock; Heart & Soul's own 5F stock is there from the start.

@ The TM clerk in every Poke Mart (behind the counter, next to the clerk)
EventScript_TMClerk::
	lock
	faceplayer
	message TMShop_Text_Welcome
	waitmessage
	call EventScript_TMShop
	msgbox gText_PleaseComeAgain, MSGBOX_DEFAULT
	release
	end

@ Opens the shop with the list for the player's badge count
EventScript_TMShop::
	specialvar VAR_RESULT, GetBadgeCount
	goto_if_ge VAR_RESULT, 8, TMShop_8
	goto_if_ge VAR_RESULT, 7, TMShop_7
	goto_if_ge VAR_RESULT, 6, TMShop_6
	goto_if_ge VAR_RESULT, 5, TMShop_5
	goto_if_ge VAR_RESULT, 4, TMShop_4
	goto_if_ge VAR_RESULT, 3, TMShop_3
	goto_if_ge VAR_RESULT, 2, TMShop_2
	goto_if_ge VAR_RESULT, 1, TMShop_1
TMShop_0:
	pokemart TMShop_List0
	return
TMShop_1:
	pokemart TMShop_List1
	return
TMShop_2:
	pokemart TMShop_List2
	return
TMShop_3:
	pokemart TMShop_List3
	return
TMShop_4:
	pokemart TMShop_List4
	return
TMShop_5:
	pokemart TMShop_List5
	return
TMShop_6:
	pokemart TMShop_List6
	return
TMShop_7:
	pokemart TMShop_List7
	return
TMShop_8:
	pokemart TMShop_List8
	return

